@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Radzen
@using SmartClass.Application.Contracts.Auth
@using SmartClass.Application.Contracts.User
@using SmartClass.Web.Components.Shared
@using SmartClass.Web.Services
@using SmartClass.Web.Components.Pages.Classrooms

@inject NavigationManager NavigationManager
@inject CurrentUserState CurrentUser
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject AuthApiClient AuthApi
@implements IDisposable

<AppUserFromLocalStorageInitializer />
<RadzenComponents />

<RadzenLayout class="main-background" style="height: 100vh; display: flex; flex-direction: column; overflow: hidden;">

    <!-- HEADER -->
    <RadzenHeader class="custom-header">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%; padding: 0 1.5rem;">

            <!-- ЛІВА ЧАСТИНА: МЕНЮ + ЛОГО -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="16px">
                @if (IsAuthenticated)
                {
                    <RadzenButton Icon="menu" Variant="Variant.Text" Style="color: var(--primary-color);" Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                }

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px" Style="cursor: pointer;" @onclick="NavigateToHome">
                    <RadzenImage Path="/logo.png" Style="width: 34px; height: 34px;" />
                    <span class="header-logo-text rz-display-none rz-display-sm-block" style="font-size: 1.25rem;">SMART CLASS</span>
                </RadzenStack>
            </RadzenStack>

            <!-- ПРАВА ЧАСТИНА: КНОПКИ / ПРОФІЛЬ -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">

                @if (!IsReady)
                {
                    <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" Style="color: var(--primary-color);" />
                }
                else if (IsAuthenticated && userInfo != null)
                {
                    <!-- Профіль -->
                    <RadzenProfileMenu Style="background-color: transparent; border: none; color: var(--primary-color);">
                        <Template>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="12px" Style="padding: 4px 8px; border-radius: 50px; transition: background 0.2s;">
                                <RadzenText Text="@($"{userInfo.Firstname} {userInfo.Lastname}")" Style="color: var(--text-main); font-weight: 600; font-size: 0.9rem;" class="rz-display-none rz-display-sm-block" />
                                <RadzenImage Path="/avatars/avatar.png" Style="width: 40px; height: 40px; border-radius: 50%; border: 2px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.1); object-fit: cover;" />
                            </RadzenStack>
                        </Template>
                        <ChildContent>
                            <div style="padding: 12px 16px; border-bottom: 1px solid #f1f5f9;">
                                <span style="display:block; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Акаунт</span>
                                <span style="display:block; font-weight: 600; color: var(--text-main); margin-top: 4px;">@userInfo.Email</span>
                            </div>

                            <RadzenProfileMenuItem Text="Мій профіль" Path="userInfo" Icon="account_circle" />



                            <RadzenButton Text="Logout" Click="@DoLogoutAsync" Icon="logout" ButtonStyle="ButtonStyle.Base " Variant="Variant.Outlined" Style="border-radius: 8px; justify-content: center" />
                        </ChildContent>
                    </RadzenProfileMenu>
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="12px">
                        <RadzenButton Text="Увійти" Click="@(() => NavigationManager.NavigateTo("/login"))" Variant="Variant.Text" Style="color: var(--primary-color); font-weight: 600;" />
                        <RadzenButton Text="Реєстрація" Click="@(() => NavigationManager.NavigateTo("/register"))" class="btn-primary-custom" />
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <div style="display: flex; flex: 1; overflow: hidden; position: relative;">

        @if (IsAuthenticated && userInfo != null)
        {
            <!-- SIDEBAR -->
            <RadzenSidebar @bind-Expanded="@sidebarExpanded" Style="width: 270px; height: 100%;">

                <div style="padding: 24px 0; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.08); margin-bottom: 10px;">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="10px" Style="cursor: pointer;" @onclick="NavigateToHome">
                        <RadzenImage Path="/logo.png" Style="width: 32px; height: 32px; filter: brightness(0) invert(1);" />
                        <span style="font-family: 'Inter', sans-serif; font-weight: 700; letter-spacing: 1px; font-size: 1.1rem; color: white;">SMART CLASS</span>
                    </RadzenStack>
                </div>

                <RadzenPanelMenu DisplayStyle="MenuItemDisplayStyle.IconAndText" ShowArrow="true">
                    <RadzenPanelMenuItem Text="Мої класи" Icon="school" Path="classrooms" />
                    <RadzenPanelMenuItem Text="Повідомлення" Icon="notifications" Path="notifications" />
                    <RadzenPanelMenuItem Text="Профіль" Icon="settings" Path="userInfo" />

                    <div style="margin-top: 30px; padding-left: 24px; margin-bottom: 10px;">
                        <span style="font-size: 0.75rem; text-transform: uppercase; color: rgba(255,255,255,0.5); font-weight: 700; letter-spacing: 1px;">Швидкі дії</span>
                    </div>

                    <RadzenPanelMenuItem Text="Створити проєкт" Icon="add_circle" Click="@OpenCreateClassDialog" />
                </RadzenPanelMenu>

                <div style="padding: 20px; margin-top: auto;">
                    <div style="background: rgba(255,255,255,0.1); border-radius: 12px; padding: 16px; text-align: center; backdrop-filter: blur(5px);">
                        <p style="margin: 0 0 10px 0; font-size: 0.8rem; color: rgba(255,255,255,0.9);">Потрібна допомога?</p>
                        <RadzenButton Text="Підтримка"
                                      Icon="help_outline"
                                      Variant="Variant.Outlined"
                                      ButtonStyle="ButtonStyle.Light"
                                      Style="width: 100%; border-radius: 8px; color: white; border-color: rgba(255,255,255,0.3); font-weight: 500;"
                                      Click="@(() => NavigationManager.NavigateTo("/support"))" />
                    </div>
                </div>
            </RadzenSidebar>
        }

        <!-- CONTENT -->
        <RadzenBody Style="flex: 1; overflow: hidden; background-color: transparent;">
            <div class="layout-content-center">

                @if (!CurrentUser.IsInitialized)
                {
                    <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="color: var(--primary-color);" />
                }
                else
                {
                    <div class="glass-card">
                        @Body
                    </div>
                }

            </div>
        </RadzenBody>

    </div>

</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
    private bool IsReady => CurrentUser.IsInitialized;
    private bool IsAuthenticated => CurrentUser.User != null;
    private UserInfoDTO? userInfo => CurrentUser.User;

    private bool IsTeacher =>
        userInfo?.Roles?.Any(r =>
            string.Equals(r, "teacher", StringComparison.OrdinalIgnoreCase) ||
            r.Contains("викладач", StringComparison.OrdinalIgnoreCase)
        ) == true;

    protected override void OnInitialized()
    {
        CurrentUser.OnChange += HandleUserStateChanged;
    }

    private void HandleUserStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CurrentUser.OnChange -= HandleUserStateChanged;
    }



    private async Task DoLogoutAsync()
    {
        // 1) спроба відправити logout на бекенд (ревокнути refresh токен)
        try
        {
            var refreshToken = await JS.InvokeAsync<string?>("localStorage.getItem", "refreshToken");

            if (!string.IsNullOrWhiteSpace(refreshToken) && CurrentUser.User != null)
            {
                var dto = new LogoutDto(CurrentUser.User.UserId, refreshToken);
                await AuthApi.LogoutAsync(dto); // метод у AuthApiClient, який б’є в api/auth/logout
            }
        }
        catch
        {
            // якщо бекенд впав — все одно лог аутимося на клієнті
        }

        // 2) чистимо localStorage
        await JS.InvokeVoidAsync("localStorage.removeItem", "accessToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "refreshToken");

        // 3) чистимо Bearer
        AuthApi.SetBearer(null);

        // 4) чистимо локальний стан
        CurrentUser.Clear();

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Logout",
            Detail = "You have been logged out.",
            Duration = 3000
        });

        NavigationManager.NavigateTo("/");
    }


    private void NavigateToHome() => NavigationManager.NavigateTo("/");

    private async Task OpenCreateClassDialog()
    {
        if (!IsTeacher)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Access denied",
                Detail = "Тільки викладачі можуть створювати класи.",
                Duration = 4000
            });
            return;
        }

        await DialogService.OpenAsync<ClassroomCreateDialog>(
            "Створення класу",
            new Dictionary<string, object>(),
            new DialogOptions
            {
                Width = "450px",
                Resizable = false,
                Draggable = true
            });
    }

    private async Task OpenJoinClassDialog()
    {
        await DialogService.OpenAsync<JoinClassroomDialog>(
            "Приєднання до класу",
            new Dictionary<string, object>(),
            new DialogOptions
            {
                Width = "400px",
                Resizable = false,
                Draggable = true
            });
    }
}
