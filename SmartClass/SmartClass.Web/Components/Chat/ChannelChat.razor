@using Microsoft.AspNetCore.SignalR.Client
@using SmartClass.Application.Contracts.Messages
@inject NavigationManager Nav

<div>
    <h3>Channel chat</h3>

    <div class="chat-window">
        @foreach (var m in messages)
        {
            <div class="msg">
                <b>@m.AuthorName</b>: @m.Text
            </div>
        }
    </div>

    <input @bind="newMessage" @onkeydown="OnKey" class="form-control" />
</div>

@code {
    [Parameter] public Guid ChannelId { get; set; }

    private HubConnection? connection;
    private string newMessage = "";
    private List<ChatMessageDto> messages = new();

    protected override async Task OnInitializedAsync()
    {
        connection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/chat"))
            .WithAutomaticReconnect()
            .Build();

        connection.On<ChatMessageDto>("newMessage", msg =>
        {
            messages.Add(msg);
            InvokeAsync(StateHasChanged);
        });

        await connection.StartAsync();
        await connection.InvokeAsync("JoinChannel", ChannelId);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && newMessage.Trim() != "")
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        await connection!.InvokeAsync("Send", newMessage);
        newMessage = "";
    }
}
