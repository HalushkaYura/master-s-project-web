@using Microsoft.AspNetCore.SignalR.Client
@using SmartClass.Application.Contracts.Notifications
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<div>
    <button @onclick="TogglePanel" class="btn btn-dark">
        🔔 (@unreadCount)
    </button>
</div>

@if (panelOpen)
{
    <div class="notification-panel">
        @foreach (var item in notifications.OrderByDescending(n => n.CreatedAt))
        {
            <div class="notification-item">
                <b>@item.Type</b><br />
                <small>@item.CreatedAt.ToLocalTime()</small>
                <pre>@item.PayloadJson</pre>
            </div>
        }
    </div>
}

@code {
    private HubConnection? connection;
    private int unreadCount = 0;
    private bool panelOpen = false;
    private readonly List<NotificationDto> notifications = new();

    protected override async Task OnInitializedAsync()
    {
        // ДЛЯ BLAZOR SERVER цієї конфігурації достатньо:
        connection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/notifications"),
                options =>
                {
                    // Якщо JWT у cookie — нічого не потрібно
                    // Якщо JWT у local storage — тут вставимо AccessTokenProvider
                })
            .WithAutomaticReconnect()
            .Build();

        connection.On<NotificationDto>("notification", dto =>
        {
            notifications.Add(dto);
            if (!dto.IsRead)
                unreadCount++;

            InvokeAsync(StateHasChanged);
        });

        await connection.StartAsync();
    }

    void TogglePanel() => panelOpen = !panelOpen;
}
