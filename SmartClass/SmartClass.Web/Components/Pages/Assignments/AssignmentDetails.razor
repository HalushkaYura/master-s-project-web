@page "/classrooms/{ClassroomId:guid}/assignments/{AssignmentId:guid}"
@layout MainLayout

@using SmartClass.Application.Abstractions
@using SmartClass.Application.Abstractions.Auth
@using SmartClass.Application.Contracts.Assignments
@using SmartClass.Application.Contracts
@using SmartClass.Application.Contracts.Submissions
@using SmartClass.Domain.Enums
@using SmartClass.Web.Services
@using Radzen

@inject IAssignmentService AssignmentService
@inject ISubmissionService SubmissionService
@inject ITokenProvider TokenProvider
@inject CurrentUserState CurrentUser
@inject NavigationManager Nav
@inject Radzen.NotificationService Toast
@inject Radzen.DialogService DialogService
@inject IJSRuntime JS

<PageTitle>@(assignment is null ? "Завдання" : assignment.Title)</PageTitle>

<div class="animate-fade-in">
    @if (isLoading)
    {
        <div style="display:flex;justify-content:center;align-items:center;height:300px;">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Medium"
                                       Style="color: var(--primary-color);" />
        </div>
    }
    else if (!IsAuthenticated)
    {
        <RadzenAlert Severity="AlertSeverity.Warning" Variant="Variant.Flat">
            Ви повинні увійти, щоб переглядати завдання.
        </RadzenAlert>
    }
    else if (error != null)
    {
        <RadzenAlert Severity="AlertSeverity.Error" Variant="Variant.Flat">
            @error
        </RadzenAlert>
    }
    else if (assignment != null)
    {
        <!-- HEADER SECTION -->
        <div class="d-flex justify-content-between align-items-start flex-wrap"
             style="border-bottom: 1px solid rgba(0,0,0,0.05); padding-bottom: 15px; margin-bottom: 25px;">
            <div style="flex: 1; min-width: 300px;">
                <h1 style="color: var(--primary-color); font-weight: 800; font-size: 2rem; margin: 0;">
                    @assignment.Title
                </h1>

                <!-- Мета-інформація -->
                <RadzenStack Orientation="Orientation.Horizontal" Gap="15px" Style="margin-top: 5px;">
                    <div class="meta-info-item">
                        <RadzenIcon Icon="calendar_today" Style="font-size: 1rem; color: var(--text-muted);" />
                        <span style="font-weight: 600; color: var(--primary-color);">
                            @(assignment.DueAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Без дедлайну")
                        </span>
                        <span style="color: var(--text-muted); font-size: 0.9rem;">(Дедлайн)</span>
                    </div>
                    <div class="meta-info-item">
                        <RadzenIcon Icon="star" Style="font-size: 1rem; color: var(--text-muted);" />
                        <span style="font-weight: 600;">@assignment.PointsMax</span>
                        <span style="color: var(--text-muted); font-size: 0.9rem;">(Балів)</span>
                    </div>
                    <div class="meta-info-item">
                        <RadzenBadge Text="@assignment.Status"
                                     BadgeStyle="@(assignment.Status == "Published"
                                                                                        ? BadgeStyle.Success
                                                                                        : assignment.Status == "Closed"
                                                                                          ? BadgeStyle.Dark
                                                                                          : BadgeStyle.Warning)"
                                 IsPill="true" />
                </div>
            </RadzenStack>

                <!-- Посилання на тему -->
            @if (!string.IsNullOrWhiteSpace(assignment.MaterialTitle) && assignment.MaterialId != null)
                {
                    <p style="margin-top: 10px; color: var(--text-secondary);">
                        Тема:
                        <RadzenLink Text="@assignment.MaterialTitle"
                                    Click="@(() => OpenMaterial(assignment.MaterialId.Value))"
                                    Style="font-weight: 600; color: var(--accent-color);" />
                    </p>
                }
            </div>

            <!-- ACTIONS (Викладач) -->
            @if (IsTeacher)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="10px" Class="rz-mt-3">
                    <RadzenButton Text="Редагувати"
                                  Icon="edit"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Variant="Variant.Outlined"
                                  Style="border-radius: 8px;" />

                    <RadzenButton Text="Видалити"
                                  Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Variant="Variant.Text"
                                  Click="@OpenDeleteDialog" />

                    @if (assignment.Status == "Draft")
                    {
                        <RadzenButton Text="Опублікувати"
                                      Icon="cloud_upload"
                                      Class="btn-primary-custom"
                                      Click="@(() => ChangeStatus("Published"))" />
                    }
                    else if (assignment.Status == "Published")
                    {
                        <RadzenButton Text="Закрити"
                                      Icon="lock"
                                      ButtonStyle="ButtonStyle.Warning"
                                      Class="btn-primary-custom"
                                      Click="@(() => ChangeStatus("Closed"))" />
                    }
                </RadzenStack>
            }
        </div>

        <!-- MAIN CONTENT LAYOUT -->
        <RadzenRow Gap="2rem">

            <!-- LEFT COLUMN: Description & Files -->
            <RadzenColumn Size="12" SizeLG="8">

                <div class="content-box">
                    <RadzenText Text="Опис завдання"
                                TextStyle="TextStyle.H5"
                                TagName="TagName.H4"
                                Style="color: var(--text-main); font-weight: 700; margin-bottom: 15px;" />

                    @if (!string.IsNullOrWhiteSpace(assignment.DescriptionHtml))
                    {
                        <div class="rich-content-display">
                            @((MarkupString)assignment.DescriptionHtml)
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Детальний опис відсутній.</p>
                    }
                </div>

                <div class="content-box rz-mt-4">
                    <RadzenText Text="Прикріплені файли (умова)"
                                TextStyle="TextStyle.H5"
                                TagName="TagName.H4"
                                Style="color: var(--text-main); font-weight: 700; margin-bottom: 15px;" />

                    @if (assignment.Files != null && assignment.Files.Any())
                    {
                        <RadzenDataGrid Data="@assignment.Files"
                                        TItem="FileResourceDto"
                                        Class="glass-grid">
                            <Columns>
                                <RadzenDataGridColumn TItem="FileResourceDto"
                                                      Property="FileName"
                                                      Title="Файл"
                                                      Width="50%" />
                                <RadzenDataGridColumn TItem="FileResourceDto"
                                                      Title="Розмір"
                                                      Width="20%">
                                    <Template Context="f">@FormatSize(f.SizeBytes)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="FileResourceDto"
                                                      Title="Дія"
                                                      Width="100px">
                                    <Template Context="f">
                                        <RadzenButton Icon="download"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Primary"
                                                      Variant="Variant.Text"
                                                      Click="@(async () => await DownloadFile(f.Id))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <p class="text-muted">Немає прикріплених файлів.</p>
                    }

                    @if (IsTeacher)
                    {
                        <div class="rz-mt-3">
                            <RadzenUpload Url="@GetAssignmentUploadUrl()"
                                          Multiple="true"
                                          Auto="true"
                                          ChooseText="Додати файл (викладач)"
                                          Complete="@OnUploadCompleted"
                                          Error="@OnUploadError">
                                @if (!string.IsNullOrWhiteSpace(uploadToken))
                                {
                                    <RadzenUploadHeader Name="Authorization"
                                                        Value="@($"Bearer {uploadToken}")" />
                                }
                            </RadzenUpload>
                        </div>
                    }
                </div>
            </RadzenColumn>

            <!-- RIGHT COLUMN: Submissions -->
            <RadzenColumn Size="12" SizeLG="4">

                @if (IsTeacher)
                {
                    <!-- TEACHER VIEW: Submissions List + grade panel -->
                    <div class="content-box sidebar-assignments-box">
                        <RadzenText Text="Відповіді студентів"
                                    TextStyle="TextStyle.H5"
                                    TagName="TagName.H4"
                                    Style="color: var(--text-main); font-weight: 700; margin-bottom: 15px;" />

                        @if (submissions == null || !submissions.Any())
                        {
                            <div class="text-center text-muted p-3"
                                 style="border: 1px dashed var(--text-muted); border-radius: 8px;">
                                <RadzenIcon Icon="group"
                                            Style="font-size: 1.5rem; margin-bottom: 8px;" />
                                <p style="font-size: 0.9rem; margin: 0;">
                                    Поки немає жодної відповіді.
                                </p>
                            </div>
                        }
                        else
                        {
                            <RadzenDataGrid Data="@submissions"
                                            TItem="SubmissionListItemDto"
                                            Class="glass-grid"
                                            RowClick="@OnSubmissionRowClick">
                                <Columns>
                                    <RadzenDataGridColumn TItem="SubmissionListItemDto"
                                                          Property="StudentName"
                                                          Title="Студент" />
                                    <RadzenDataGridColumn TItem="SubmissionListItemDto"
                                                          Title="Статус">
                                        <Template Context="s">
                                            @s.Status.ToString()
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SubmissionListItemDto"
                                                          Title="Надіслано">
                                        <Template Context="s">
                                            @if (s.SubmittedAt != null)
                                            {
                                                @s.SubmittedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="SubmissionListItemDto"
                                                          Title="Оцінка">
                                        <Template Context="s">
                                            @s.Score
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>

                            @if (selectedSubmission != null)
                            {
                                <div class="rz-mt-3"
                                     style="border-top:1px solid rgba(148,163,184,0.4); padding-top:10px;">
                                    <RadzenText Text="Оцінювання відповіді"
                                                TextStyle="TextStyle.Subtitle2"
                                                Style="font-weight:700; margin-bottom:8px;" />
                                    <p style="font-size:0.9rem; margin-bottom:6px;">
                                        Студент: <b>@selectedSubmission.StudentName</b>
                                    </p>

                                    <RadzenLabel Text="Оцінка" />
                                    <RadzenNumeric @bind-Value="gradeValue"
                                                   Min="0"
                                                   Max="@assignment.PointsMax"
                                                   Style="width:100%; margin-bottom:6px;" />

                                    <RadzenLabel Text="Коментар викладача" />
                                    <RadzenTextArea @bind-Value="gradeComment"
                                                    Rows="3"
                                                    Style="width:100%; margin-bottom:8px;" />

                                    <div style="display:flex; gap:8px; justify-content:flex-end;">
                                        <RadzenButton Text="Скасувати"
                                                      Icon="close"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Variant="Variant.Outlined"
                                                      Click="@ClearGradeForm" />
                                        <RadzenButton Text="Зберегти оцінку"
                                                      Icon="check"
                                                      Class="btn-primary-custom"
                                                      Click="@SaveGradeAsync" />
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else if (IsStudent)
                {
                    <!-- STUDENT VIEW: My Submission Panel -->
                    <div class="content-box sidebar-assignments-box">
                        <RadzenText Text="Ваша робота"
                                    TextStyle="TextStyle.H5"
                                    TagName="TagName.H4"
                                    Style="color: var(--text-main); font-weight: 700; margin-bottom: 15px;" />

                        @if (mySubmission is null)
                        {
                            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                                       Size="ProgressBarCircularSize.Small" />
                        }
                        else
                        {
                            <div class="submission-panel">
                                <p style="font-weight: 600; color: var(--accent-color);">
                                    Статус: @mySubmission.Status.ToString()
                                </p>

                                <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom:8px;">
                                    @if (mySubmission.SubmittedAt != null)
                                    {
                                        <span>Відправлено: @mySubmission.SubmittedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span>Ви ще не здали роботу.</span>
                                    }

                                    @if (mySubmission.Score != null)
                                    {
                                        <br />
                                        <span>Оцінка: <b>@mySubmission.Score</b></span>
                                        @if (!string.IsNullOrWhiteSpace(mySubmission.TeacherComment))
                                        {
                                            <br />
                                            <span>Коментар: @mySubmission.TeacherComment</span>
                                        }
                                    }
                                </p>

                                <!-- Upload files -->
                                <RadzenUpload Url="@GetSubmissionUploadUrl()"
                                              Multiple="true"
                                              Auto="true"
                                              ChooseText="Прикріпити файли відповіді"
                                              Complete="@OnSubmissionUploadCompleted"
                                              Error="@OnSubmissionUploadError"
                                              Style="margin-bottom:10px;">
                                    @if (!string.IsNullOrWhiteSpace(uploadToken))
                                    {
                                        <RadzenUploadHeader Name="Authorization"
                                                            Value="@($"Bearer {uploadToken}")" />
                                    }
                                </RadzenUpload>

                                <!-- Button 'Submit work' -->
                                <RadzenButton Text="Здати роботу"
                                              Icon="send"
                                              Class="btn-primary-custom rz-mt-2"
                                              Disabled="@(!CanSubmitNow)"
                                              Click="@SubmitMyWorkAsync" />

                                @if (mySubmission.Files != null && mySubmission.Files.Any())
                                {
                                    <RadzenDataGrid Data="@mySubmission.Files"
                                                    TItem="FileResourceDto"
                                                    Class="glass-grid rz-mt-3">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="FileResourceDto"
                                                                  Property="FileName"
                                                                  Title="Файл" />
                                            <RadzenDataGridColumn TItem="FileResourceDto"
                                                                  Title="Розмір">
                                                <Template Context="f">
                                                    @FormatSize(f.SizeBytes)
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="FileResourceDto"
                                                                  Title="">
                                                <Template Context="f">
                                                    <RadzenButton Icon="download"
                                                                  Size="ButtonSize.Small"
                                                                  ButtonStyle="ButtonStyle.Primary"
                                                                  Variant="Variant.Text"
                                                                  Click="@(async () => await DownloadFile(f.Id))" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                                else
                                {
                                    <p class="text-muted" style="font-size:0.85rem; margin-top:8px;">
                                        Ви ще не додали жодного файлу до відповіді.
                                    </p>
                                }
                            </div>
                        }
                    </div>
                }
            </RadzenColumn>
        </RadzenRow>
    }
</div>

<style>
    .meta-info-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 0;
        font-size: 0.95rem;
    }

    .content-box {
        background: rgba(255, 255, 255, 0.7);
        padding: 24px;
        border-radius: 16px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .sidebar-assignments-box {
        background: rgba(240, 245, 255, 0.9);
        border: 1px solid var(--primary-light);
    }

    .rich-content-display {
        border-radius: 12px;
        padding: 12px 14px;
        background: rgba(255,255,255,0.9);
        border: 1px solid rgba(148,163,184,0.3);
    }
</style>

@code {
    [Parameter] public Guid ClassroomId { get; set; }
    [Parameter] public Guid AssignmentId { get; set; }

    private AssignmentDetailsDto? assignment;
    private bool isLoading = true;
    private string? error;

    private SubmissionDetailsDto? mySubmission;
    private List<SubmissionListItemDto> submissions = new();

    // Для оцінювання (викладач):
    private SubmissionListItemDto? selectedSubmission;
    private decimal? gradeValue;
    private string? gradeComment;

    private string? uploadToken;

    private bool IsAuthenticated => CurrentUser.User != null;

    private bool IsTeacher =>
        CurrentUser.User?.Roles?.Any(r =>
            string.Equals(r, "teacher", StringComparison.OrdinalIgnoreCase) ||
            r.Contains("викладач", StringComparison.OrdinalIgnoreCase)
        ) == true;

    private bool IsStudent =>
        CurrentUser.User?.Roles?.Any(r =>
            string.Equals(r, "student", StringComparison.OrdinalIgnoreCase) ||
            r.Contains("студент", StringComparison.OrdinalIgnoreCase)
        ) == true;

    private bool CanSubmitNow =>
        mySubmission != null
        && (mySubmission.Status == SubmissionStatus.NotSubmitted
            || mySubmission.Status == SubmissionStatus.ReturnedForRevision
            || mySubmission.Status == SubmissionStatus.Submitted)
        && mySubmission.Files != null
        && mySubmission.Files.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        uploadToken = await TokenProvider.GetAccessTokenAsync();

        await LoadAssignment();

        if (IsStudent)
            await LoadMySubmission();

        if (IsTeacher)
            await LoadSubmissionsForTeacher();
    }

    private async Task LoadAssignment()
    {
        isLoading = true;
        error = null;

        try
        {
            if (!IsAuthenticated)
                return;

            assignment = await AssignmentService.GetByIdAsync(ClassroomId, AssignmentId, CancellationToken.None);
            if (assignment == null)
                error = "Завдання не знайдено.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMySubmission()
    {
        try
        {
            mySubmission = await SubmissionService.EnsureForStudentAsync(
                AssignmentId,
                Guid.Parse(CurrentUser.User!.UserId),
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка завантаження відповіді",
                Detail = ex.Message
            });
        }
    }

    private async Task LoadSubmissionsForTeacher()
    {
        try
        {
            submissions = (await SubmissionService.GetForAssignmentAsync(
                AssignmentId,
                CancellationToken.None)).ToList();
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка завантаження відповідей",
                Detail = ex.Message
            });
        }
    }

    private string GetAssignmentUploadUrl()
        => $"/api/files/upload/assignment/{AssignmentId}?classroomId={ClassroomId}";

    private string GetSubmissionUploadUrl()
        => mySubmission is null
            ? string.Empty
            : $"/api/files/upload/submission?submissionId={mySubmission.Id}&classroomId={ClassroomId}";

    private async Task OnUploadCompleted(UploadCompleteEventArgs _)
    {
        Toast.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Файл(и) завантажено",
            Detail = "Список файлів завдання оновлено.",
            Duration = 3000
        });

        await LoadAssignment();
        StateHasChanged();
    }

    private void OnUploadError(UploadErrorEventArgs args)
    {
        Toast.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Помилка завантаження файлу",
            Detail = args.Message,
            Duration = 5000
        });
    }

    private async Task OnSubmissionUploadCompleted(UploadCompleteEventArgs _)
    {
        Toast.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Відповідь завантажено",
            Detail = "Файли прикріплено до вашої роботи.",
            Duration = 3000
        });

        await LoadMySubmission();
        StateHasChanged();
    }

    private void OnSubmissionUploadError(UploadErrorEventArgs args)
    {
        Toast.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Помилка завантаження відповіді",
            Detail = args.Message,
            Duration = 5000
        });
    }

    private async Task DownloadFile(Guid fileId)
    {
        var url = $"/api/files/{fileId}/download";
        Nav.NavigateTo(url, forceLoad: true);
        await Task.CompletedTask;
    }

    private void OpenMaterial(Guid materialId)
        => Nav.NavigateTo($"/classrooms/{ClassroomId}/materials/{materialId}");

    private async Task OpenDeleteDialog()
    {
        var confirm = await DialogService.Confirm(
            "Функціонал повного видалення завдання буде реалізовано пізніше.",
            "Підтвердження");

        if (confirm == true)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Видалення",
                Detail = "Зараз видалення не реалізовано.",
                Duration = 3000
            });
        }
    }

    private Task ChangeStatus(string newStatus)
    {
        Toast.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Зміна статусу",
            Detail = "Зміна статусу поки не реалізована на бекенді.",
            Duration = 3000
        });

        return Task.CompletedTask;
    }

    // ====== STUDENT: SUBMIT WORK ======
    private async Task SubmitMyWorkAsync()
    {
        if (mySubmission is null)
            return;

        if (!CanSubmitNow)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Не можна здати роботу",
                Detail = "Прикріпіть хоча б один файл перед здачею.",
                Duration = 4000
            });
            return;
        }

        try
        {
            await SubmissionService.SubmitAsync(mySubmission.Id, CancellationToken.None);

            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Роботу здано",
                Detail = "Ваша відповідь відправлена викладачу.",
                Duration = 4000
            });

            await LoadMySubmission();
            if (IsTeacher)
                await LoadSubmissionsForTeacher();
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка здачі роботи",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    // ====== TEACHER: CHOOSE SUBMISSION & GRADE ======
    private void OnSubmissionRowClick(DataGridRowMouseEventArgs<SubmissionListItemDto> args)
    {
        selectedSubmission = args.Data;
        gradeValue = selectedSubmission.Score;
        gradeComment = null;
    }

    private void ClearGradeForm()
    {
        selectedSubmission = null;
        gradeValue = null;
        gradeComment = null;
    }

    private async Task SaveGradeAsync()
    {
        if (selectedSubmission == null)
            return;

        if (!gradeValue.HasValue)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Оцінка не вказана",
                Detail = "Введіть бал перед збереженням.",
                Duration = 4000
            });
            return;
        }

        if (CurrentUser.User is null || !Guid.TryParse(CurrentUser.User.UserId, out var teacherId))
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка",
                Detail = "Некоректний викладач.",
                Duration = 4000
            });
            return;
        }

        try
        {
            var dto = new GradeSubmissionDto(
                selectedSubmission.Id,
                gradeValue.Value,
                gradeComment
            );

            await SubmissionService.GradeAsync(dto, teacherId, CancellationToken.None);

            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Оцінка збережена",
                Detail = "Оцінка успішно виставлена.",
                Duration = 4000
            });

            await LoadSubmissionsForTeacher();

            if (IsStudent)
                await LoadMySubmission();

            ClearGradeForm();
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка збереження оцінки",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        var kb = bytes / 1024d;
        if (kb < 1024) return $"{kb:F1} KB";
        var mb = kb / 1024d;
        return $"{mb:F1} MB";
    }
}
