@page "/"
@using Radzen
@using SmartClass.Application.Contracts.Classrooms
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Radzen.NotificationService NotificationService

<PageTitle>SmartClass Dashboard</PageTitle>

<div class="dashboard-header mb-4">
    <h1 class="display-6">Мої класи</h1>
    <p class="text-secondary">Класи, в яких ви викладаєте або навчаєтесь.</p>
</div>

<div class="d-flex justify-content-between mb-3">
    <RadzenButton Text="Створити клас"
                  Icon="add"
                  Style="background:#1cc88a;color:white"
                  Click="@(() => Nav.NavigateTo("/classrooms/create"))" />
</div>

@if (loading)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
}
else if (classrooms == null || !classrooms.Any())
{
    <div class="alert alert-info">
        Поки що немає жодного класу.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var c in classrooms)
        {
            <div class="col">
                <RadzenCard Class="p-3 class-card shadow-sm">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5>@c.Title</h5>
                            @if (!string.IsNullOrWhiteSpace(c.Section))
                            {
                                <p class="text-secondary mb-1">@c.Section</p>
                            }
                            <span class="badge bg-primary">@c.RoleInClass</span>
                        </div>
                        <div class="text-end">
                            <small class="text-muted">Код: @c.JoinCode</small><br />
                            <RadzenButton Text="Відкрити"
                                          Icon="school"
                                          Size="ButtonSize.Small"
                                          Style="margin-top:6px;background:#4e73df;color:white"
                                          Click="@(() => Nav.NavigateTo($"/classrooms/{c.Id}"))" />
                        </div>
                    </div>
                </RadzenCard>
            </div>
        }
    </div>
}

@code {
    private bool loading = true;
    private List<MyClassroomDto>? classrooms;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "accessToken");
            if (string.IsNullOrWhiteSpace(token))
            {
                loading = false;
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            classrooms = await Http.GetFromJsonAsync<List<MyClassroomDto>>("api/Classrooms/mine");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка",
                Detail = "Не вдалося завантажити класи."
            });
        }

        loading = false;
    }
}
