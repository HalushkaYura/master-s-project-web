@page "/"
@using SmartClass.Web.Components.Layout
@using SmartClass.Web.Services
@layout MainLayout
@inject CurrentUserState CurrentUser
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Smart Class</PageTitle>

@if (CurrentUser.User is null)
{
    <!-- ГІСТЬ / НЕАВТОРИЗОВАНИЙ -->
    <div class="text-center">
        <h1>Smart Class</h1>
        <p class="mt-3" style="font-size:18px; color:#455A64;">
            Smart Class — це проста мінімалістична платформа для організації навчальних класів,
            розміщення матеріалів та комунікації між викладачами і студентами.
        </p>

        <p style="color:#607D8B;">
            Щоб створювати або відвідувати навчальні класи, увійдіть у систему або зареєструйтесь.
        </p>

        <div class="mt-4">
            <RadzenButton Text="Увійти"
                          Style="margin-right: 10px; min-width:140px;"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => Nav.NavigateTo("/login"))" />
            <RadzenButton Text="Зареєструватися"
                          Variant="Variant.Outlined"
                          ButtonStyle="ButtonStyle.Primary"
                          Style="min-width:160px;"
                          Click="@(() => Nav.NavigateTo("/register"))" />
        </div>
    </div>
}
else
{
    <!-- АВТОРИЗОВАНИЙ КОРИСТУВАЧ -->
    <div>
        <h2>Вітаємо в Smart Class 👋</h2>
        <p class="mt-2" style="color:#607D8B;">
            Тут ви можете керувати своїми навчальними класами, матеріалами та завданнями.
        </p>

        <RadzenAlert Style="margin-top: 16px; background-color:#E3F2FD; border:none; color:#0D47A1;">
            Використовуйте меню зліва для переходу до списку класів, повідомлень або профілю.
            Кнопки <b>“Створити клас”</b> і <b>“Приєднатися до класу”</b> доступні у верхній панелі.
        </RadzenAlert>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        // Підписуємося на зміну стану користувача
        CurrentUser.OnChange += HandleUserStateChanged;
    }

    private void HandleUserStateChanged()
    {
        // Перерендерити компонент, коли логін/логаут
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CurrentUser.OnChange -= HandleUserStateChanged;
    }
}
