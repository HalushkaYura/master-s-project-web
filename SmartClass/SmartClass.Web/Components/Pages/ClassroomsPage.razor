@page "/classrooms"
@using System.Net.Http.Headers
@using SmartClass.Web.Services
@inject HttpClient Http
@inject DevJwtState JwtState
@inject NavigationManager Nav

<h3>Мої класи</h3>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="ToggleCreate">+ Створити клас (Teacher)</button>
    <button class="btn btn-outline-secondary" @onclick="ToggleJoin">Приєднатися за кодом (Student)</button>
</div>

@if (showCreate)
{
    <div class="card mb-3 p-3">
        <h5>Створення класу</h5>
        <div class="mb-2">
            <label>Назва</label>
            <input class="form-control" @bind="createModel.Title" />
        </div>
        <div class="mb-2">
            <label>Розділ</label>
            <input class="form-control" @bind="createModel.Section" />
        </div>
        <div class="mb-2">
            <label>Опис</label>
            <textarea class="form-control" rows="2" @bind="createModel.Description"></textarea>
        </div>
        <button class="btn btn-success" @onclick="CreateClassroomAsync">Створити</button>
    </div>
}

@if (showJoin)
{
    <div class="card mb-3 p-3">
        <h5>Приєднання до класу</h5>
        <div class="mb-2">
            <label>Код приєднання</label>
            <input class="form-control" @bind="joinCode" />
        </div>
        <button class="btn btn-primary" @onclick="JoinClassroomAsync">Приєднатися</button>
        @if (!string.IsNullOrEmpty(joinResult))
        {
            <div class="mt-2 small">@joinResult</div>
        }
    </div>
}

@if (classrooms is null)
{
    <p><i>Завантаження...</i></p>
}
else if (classrooms.Count == 0)
{
    <p>Класів ще немає.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var c in classrooms)
        {
            <div class="col">
                <div class="card h-100 p-3">
                    <h5>@c.Title</h5>
                    @if (!string.IsNullOrWhiteSpace(c.Section))
                    {
                        <div class="text-muted">@c.Section</div>
                    }
                    <p>@c.Description</p>
                    <div class="small text-muted">Join code: <b>@c.JoinCode</b></div>
                    <button class="btn btn-sm btn-outline-primary mt-2"
                            @onclick="@(() => OpenClassroom(c.Id))">
                        Відкрити
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<MyClassroomVm>? classrooms;
    private bool showCreate;
    private bool showJoin;
    private CreateClassroomModel createModel = new();
    private string joinCode = "";
    private string? joinResult;

    protected override async Task OnInitializedAsync()
    {
        JwtState.Changed += async () => await ReloadAsync();
        await ReloadAsync();
    }

    private bool SetAuthHeader()
    {
        if (string.IsNullOrWhiteSpace(JwtState.Token))
            return false;

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", JwtState.Token);
        return true;
    }

    private async Task ReloadAsync()
    {
        if (!SetAuthHeader())
        {
            classrooms = new();
            StateHasChanged();
            return;
        }

        // твій ендпоінт: GET api/Classrooms/mine
        classrooms = await Http.GetFromJsonAsync<List<MyClassroomVm>>("api/Classrooms/mine");
        StateHasChanged();
    }

    private void ToggleCreate() => showCreate = !showCreate;
    private void ToggleJoin() => showJoin = !showJoin;

    private async Task CreateClassroomAsync()
    {
        if (!SetAuthHeader()) return;

        // твій CreateClassroomCommand: поля title, section, description
        var command = new
        {
            title = createModel.Title,
            section = createModel.Section,
            description = createModel.Description
        };

        var response = await Http.PostAsJsonAsync("api/Classrooms", command);
        response.EnsureSuccessStatusCode();

        createModel = new();
        showCreate = false;

        await ReloadAsync();
    }

    private async Task JoinClassroomAsync()
    {
        if (!SetAuthHeader()) return;

        var command = new
        {
            joinCode = joinCode
        };

        var response = await Http.PostAsJsonAsync("api/Classrooms/join", command);
        if (response.IsSuccessStatusCode)
        {
            joinResult = "Успішно приєднано.";
            await ReloadAsync();
        }
        else
        {
            joinResult = $"Помилка: {response.StatusCode}";
        }
    }

    private void OpenClassroom(Guid id)
    {
        Nav.NavigateTo($"/classrooms/{id}");
    }

    // має відповідати тому, що повертає GetMyClassroomsQuery
    private class MyClassroomVm
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? Section { get; set; }
        public string? Description { get; set; }
        public string JoinCode { get; set; } = string.Empty;
    }

    private class CreateClassroomModel
    {
        public string Title { get; set; } = string.Empty;
        public string? Section { get; set; }
        public string? Description { get; set; }
    }
}
