@page "/register"
@using Radzen
@using SmartClass.Application.Contracts.Auth
@using SmartClass.Web.Services
@inject AuthApiClient AuthApi
@inject CurrentUserState CurrentUser
@inject NavigationManager Navigation
@inject Radzen.NotificationService Toast
@inject IJSRuntime JS
@rendermode InteractiveServer

<EditForm Model="@model" OnValidSubmit="@(() => HandleRegistration(model))">
    <div class="row">
        <div class="col-md-6 offset-md-3 col-lg-4 offset-lg-4">
            <section>
                <h2 class="text-center text-login">Register a new account.</h2>
                <hr />
                <div class="form-group m-2">
                    <label class="text-login">First Name</label>
                    <RadzenTextBox @bind-Value="model.FirstName" Placeholder="First Name" class="form-control" Name="Firstname" />
                </div>
                <div class="form-group m-2">
                    <label class="text-login">Last Name</label>
                    <RadzenTextBox @bind-Value="model.LastName" Placeholder="Last Name" class="form-control" Name="Lastname" />
                </div>
                <div class="form-group m-2">
                    <label class="text-login">Email</label>
                    <RadzenTextBox @bind-Value="model.Email" Placeholder="name@example.com" class="form-control" Name="Email" />
                </div>

                <div class="form-group m-2">
                    <label class="text-login">Password</label>
                    <RadzenPassword @bind-Value="model.Password" Placeholder="Password" class="form-control" Name="Password" />
                </div>
                <div class="form-group m-2">
                    <label class="text-login">Birth Date</label>
                    <RadzenDatePicker @bind-Value="model.BirthDate"
                                      Placeholder="Birth Date"
                                      class="form-control"
                                      Name="BirthDate" />
                </div>

                <div class="form-group m-2">
                    <label class="text-login">Role</label>
                    <RadzenDropDown @bind-Value="model.Role"
                                    TValue="string"
                                    Data="@roles"
                                    TextProperty="Text"
                                    ValueProperty="Value"
                                    Style="width:100%"
                                    Placeholder="Select role" />
                </div>

                <div class="text-center m-2">
                    <RadzenButton Text="Register" ButtonType="ButtonType.Submit" Icon="person_add" class="btn btn-primary btn-block m-2" />
                </div>
                <div class="text-center mt-3">
                    <RadzenLink Style="color:azure" Text="Already have an account? Log in" Path="/login" />
                </div>
            </section>
        </div>
    </div>
</EditForm>

@code {
    private RegisterDto model = new RegisterDto();
    
    private List<RoleOption> roles = new()
    {
        new RoleOption { Text = "Student", Value = "Student" },
        new RoleOption { Text = "Teacher", Value = "Teacher" }
    };

    private async Task HandleRegistration(RegisterDto model)
    {
        try
        {
            var tokens = await AuthApi.RegisterAsync(model);
            if (tokens is null)
            {
                Toast.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Registration failed",
                    Detail = "Server returned an error.",
                    Duration = 4000
                });
                return;
            }

            // Зберігаємо токени в localStorage
            await JS.InvokeVoidAsync("localStorage.setItem", "accessToken", tokens.AccessToken);
            await JS.InvokeVoidAsync("localStorage.setItem", "refreshToken", tokens.RefreshToken.Token);

            // Підтягуємо поточного користувача
            AuthApi.SetBearer(tokens.AccessToken);
            var me = await AuthApi.GetCurrentUserAsync();
            if (me != null)
            {
                CurrentUser.SetAuth(tokens, me);
            }

            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Registration successful",
                Detail = "Your account has been created.",
                Duration = 3000
            });

            await Task.Delay(500);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private sealed class RoleOption
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }
}
