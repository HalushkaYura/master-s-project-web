@page "/register"
@layout MainLayout
@using Radzen
@using SmartClass.Application.Contracts.Auth
@using SmartClass.Web.Services
@inject AuthApiClient AuthApi
@inject CurrentUserState CurrentUser
@inject NavigationManager Navigation
@inject Radzen.NotificationService Toast
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Реєстрація</PageTitle>

<div class="register-container">

    <div class="glass-card register-card animate-fade-in">

        <!-- Заголовок -->
        <div class="text-center mb-4">
            <RadzenImage Path="/logo.png" Style="width: 50px; height: 50px; margin-bottom: 10px;" />
            <h2 style="color: var(--primary-color); font-weight: 800; margin: 0; font-size: 1.8rem;">Створити акаунт</h2>
            <p style="color: var(--text-secondary); font-size: 0.95rem;">Заповніть форму для реєстрації</p>
        </div>

        <EditForm Model="@model" OnValidSubmit="@(() => HandleRegistration(model))">
            <DataAnnotationsValidator />

            <RadzenStack Gap="1rem">

                <RadzenRow RowGap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText Text="Ім'я" TextStyle="TextStyle.Subtitle2" Style="color: var(--text-main); font-weight: 600; margin-bottom: 4px;" />
                        <RadzenTextBox @bind-Value="model.FirstName" Placeholder="Іван" Name="Firstname" Style="width: 100%;" />
                        <ValidationMessage For="@(() => model.FirstName)" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText Text="Прізвище" TextStyle="TextStyle.Subtitle2" Style="color: var(--text-main); font-weight: 600; margin-bottom: 4px;" />
                        <RadzenTextBox @bind-Value="model.LastName" Placeholder="Петренко" Name="Lastname" Style="width: 100%;" />
                        <ValidationMessage For="@(() => model.LastName)" />
                    </RadzenColumn>
                </RadzenRow>

                <div>
                    <RadzenText Text="Електронна пошта" TextStyle="TextStyle.Subtitle2" Style="color: var(--text-main); font-weight: 600; margin-bottom: 4px;" />
                    <RadzenTextBox @bind-Value="model.Email" Placeholder="name@example.com" Name="Email" Style="width: 100%;" />
                    <ValidationMessage For="@(() => model.Email)" />
                </div>

                <div>
                    <RadzenText Text="Пароль" TextStyle="TextStyle.Subtitle2" Style="color: var(--text-main); font-weight: 600; margin-bottom: 4px;" />
                    <RadzenPassword @bind-Value="model.Password" Placeholder="••••••••" Name="Password" Style="width: 100%;" />
                    <ValidationMessage For="@(() => model.Password)" />
                </div>

                <RadzenRow RowGap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText Text="Дата народження" TextStyle="TextStyle.Subtitle2" Style="color: var(--text-main); font-weight: 600; margin-bottom: 4px;" />
                        <RadzenDatePicker @bind-Value="model.BirthDate" Placeholder="Оберіть дату" Name="BirthDate" Style="width: 100%;" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText Text="Роль" TextStyle="TextStyle.Subtitle2" Style="color: var(--text-main); font-weight: 600; margin-bottom: 4px;" />
                        <RadzenDropDown @bind-Value="model.Role" Data="@roles" TextProperty="Text" ValueProperty="Value" Placeholder="Хто ви?" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>

                <!-- Кнопка реєстрації -->
                <button type="submit" class="btn-primary-custom w-100 mt-2" style="padding: 12px !important; font-size: 1rem; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <RadzenIcon Icon="person_add" />
                    <span>Зареєструватися</span>
                </button>

            </RadzenStack>
        </EditForm>

        <!-- Футер -->
        <div class="text-center mt-4 pt-3" style="border-top: 1px solid rgba(0,0,0,0.05);">
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 10px;">Вже є акаунт?</p>
            <RadzenLink Path="/login" Text="Увійти в систему" Style="color: var(--primary-color); font-weight: 600; text-decoration: none;" />
        </div>

    </div>
</div>

<style>
    /* Локальні стилі для центрування */
    .register-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        padding: 20px;
    }

    .register-card {
        max-width: 550px !important; /* Трохи ширша картка для форми в дві колонки */
        padding: 40px !important;
    }
</style>

@code {
    private RegisterDto model = new RegisterDto();

    private List<RoleOption> roles = new()
    {
        new RoleOption { Text = "Student", Value = "Student" },
        new RoleOption { Text = "Teacher", Value = "Teacher" }
    };

    private async Task HandleRegistration(RegisterDto model)
    {
        try
        {
            var tokens = await AuthApi.RegisterAsync(model);
            if (tokens is null)
            {
                Toast.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Registration failed",
                    Detail = "Server returned an error.",
                    Duration = 4000
                });
                return;
            }

            // 1) Зберігаємо токени в localStorage
            await JS.InvokeVoidAsync("localStorage.setItem", "accessToken", tokens.AccessToken);
            await JS.InvokeVoidAsync("localStorage.setItem", "refreshToken", tokens.RefreshToken.Token);

            // 2) Ставимо Bearer у HttpClient
            AuthApi.SetBearer(tokens.AccessToken);

            // 3) Тягнемо дані користувача
            var me = await AuthApi.GetCurrentUserAsync();
            if (me != null)
            {
                CurrentUser.SetAuth(tokens, me);
            }

            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Registration successful",
                Detail = "Your account has been created.",
                Duration = 3000
            });

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private sealed class RoleOption
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }
}