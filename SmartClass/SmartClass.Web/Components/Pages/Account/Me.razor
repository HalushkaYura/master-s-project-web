@page "/me"
@using Radzen
@using SmartClass.Application.Contracts.Auth
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Radzen.NotificationService NotificationService

<div class="profile-container card shadow-lg p-4 mt-4">
    @if (loading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (user == null)
    {
        <div class="alert alert-danger">
            Не вдалося завантажити профіль.
            <button class="btn btn-link p-0 ms-2" @onclick="GoToLogin">Увійти</button>
        </div>
    }
    else
    {
        <div class="text-center mb-4">
            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(user.DisplayName)&background=4e73df&color=fff"
                 class="avatar-lg shadow" />
            <h2 class="mt-3">@user.DisplayName</h2>
            <p class="text-secondary">@user.Email</p>
        </div>

        <RadzenCard Class="p-3 shadow-sm">
            <h5>Ролі</h5>
            @if (user.Roles?.Length > 0)
            {
                @foreach (var role in user.Roles)
                {
                    <span class="badge bg-primary me-1">@role</span>
                }
            }
            else
            {
                <span class="text-muted">Ролей не знайдено</span>
            }
        </RadzenCard>

        <div class="mt-4 text-center">
            <RadzenButton Text="Вийти"
                          Icon="logout"
                          Style="background:#dc3545;color:white"
                          Click="Logout" />
        </div>
    }
</div>

@code {
    private UserInfoDto? user;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "accessToken");
            if (!string.IsNullOrWhiteSpace(token))
            {
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                user = await Http.GetFromJsonAsync<UserInfoDto>("api/account/me");
            }
        }
        catch
        {
            user = null;
        }
        loading = false;
    }

    private void GoToLogin() => Nav.NavigateTo("/login", true);

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "accessToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "refreshToken");

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Logged out",
            Detail = "Ви вийшли з акаунта."
        });

        Nav.NavigateTo("/login", true);
    }
}
