@page "/classrooms/{Id:guid}"
@using System.Net.Http.Headers
@using SmartClass.Web.Services
@inject HttpClient Http
@inject DevJwtState JwtState

<h3>Клас @Id</h3>

<button class="btn btn-primary mb-3" @onclick="ToggleCreateAssignment">+ Створити завдання (Teacher)</button>

@if (showCreate)
{
    <div class="card mb-3 p-3">
        <h5>Нове завдання</h5>
        <div class="mb-2">
            <label>Назва</label>
            <input class="form-control" @bind="createModel.Title" />
        </div>
        <div class="mb-2">
            <label>Опис (HTML/текст)</label>
            <textarea class="form-control" rows="3" @bind="createModel.DescriptionHtml"></textarea>
        </div>
        <div class="mb-2">
            <label>Макс. балів</label>
            <input type="number" class="form-control" @bind="createModel.PointsMax" />
        </div>
        <div class="mb-2">
            <label>Дедлайн</label>
            <input type="datetime-local" class="form-control" @bind="createModel.DueAtLocal" />
        </div>
        <button class="btn btn-success" @onclick="CreateAssignmentAsync">Створити</button>
    </div>
}

@if (assignments is null)
{
    <p><i>Завантаження...</i></p>
}
else if (assignments.Count == 0)
{
    <p>Завдань поки немає.</p>
}
else
{
    <ul class="list-group">
        @foreach (var a in assignments)
        {
            <li class="list-group-item">
                <div class="fw-bold">@a.Title</div>
                <div class="small text-muted">
                    Макс: @a.PointsMax
                    @if (a.DueAt.HasValue)
                    {
                        <span> | Дедлайн: @a.DueAt.Value.ToLocalTime()</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(a.DescriptionHtml))
                {
                    <div class="mt-1">@((MarkupString)a.DescriptionHtml)</div>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private List<AssignmentVm>? assignments;
    private bool showCreate;
    private CreateAssignmentModel createModel = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private bool SetAuthHeader()
    {
        if (string.IsNullOrWhiteSpace(JwtState.Token))
            return false;

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", JwtState.Token);
        return true;
    }

    private async Task ReloadAsync()
    {
        if (!SetAuthHeader())
        {
            assignments = new();
            StateHasChanged();
            return;
        }

        // твій ендпоінт: GET api/Assignments/{classroomId}
        assignments = await Http.GetFromJsonAsync<List<AssignmentVm>>($"api/Assignments/{Id}");
        StateHasChanged();
    }

    private void ToggleCreateAssignment() => showCreate = !showCreate;

    private async Task CreateAssignmentAsync()
    {
        if (!SetAuthHeader()) return;

        var command = new
        {
            classroomId = Id,
            title = createModel.Title,
            descriptionHtml = createModel.DescriptionHtml,
            pointsMax = createModel.PointsMax,
            dueAt = createModel.DueAtLocal,
            allowLate = true
        };

        var response = await Http.PostAsJsonAsync("api/Assignments", command);
        response.EnsureSuccessStatusCode();

        createModel = new();
        showCreate = false;

        await ReloadAsync();
    }

    private class AssignmentVm
    {
        public Guid Id { get; set; }
        public Guid ClassroomId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? DescriptionHtml { get; set; }
        public int PointsMax { get; set; }
        public DateTime? DueAt { get; set; }
        public string Status { get; set; } = string.Empty;
    }

    private class CreateAssignmentModel
    {
        public string Title { get; set; } = string.Empty;
        public string? DescriptionHtml { get; set; }
        public int PointsMax { get; set; } = 100;
        public DateTime? DueAtLocal { get; set; }
    }
}
