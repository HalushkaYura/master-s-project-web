@page "/classrooms/{ClassroomId:guid}"
@layout MainLayout

@using SmartClass.Application.Abstractions
@using SmartClass.Application.Contracts.Classrooms
@using SmartClass.Web.Services
@using Radzen

@inject IClassroomService ClassroomService
@inject CurrentUserState CurrentUser
@inject NavigationManager Nav
@inject Radzen.NotificationService Toast
@inject IJSRuntime JS

<PageTitle>@(details is null ? "Клас" : details.Title)</PageTitle>

<div class="animate-fade-in">

    @if (isLoading)
    {
        <div style="display: flex; justify-content: center; align-items: center; height: 300px;">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" Style="color: var(--primary-color);" />
        </div>
    }
    else if (!IsAuthenticated)
    {
        <RadzenAlert Severity="AlertSeverity.Warning" Variant="Variant.Flat" Shade="Shade.Light" Style="border-radius: 12px; border: 1px solid #fcd34d;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenIcon Icon="lock" />
                <span>Ви повинні увійти в систему, щоб переглянути деталі класу.</span>
            </RadzenStack>
        </RadzenAlert>
    }
    else if (error != null)
    {
        <RadzenAlert Severity="AlertSeverity.Error" Variant="Variant.Flat" Shade="Shade.Lighter" Style="border-radius: 12px;">
            @error
        </RadzenAlert>
    }
    else if (details != null)
    {
        <!-- HEADER SECTION -->
        <div class="classroom-header">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Wrap="FlexWrap.Wrap" Gap="20px">

                <!-- Title & Meta -->
                <div style="flex: 1; min-width: 300px;">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px">
                        <div class="class-icon-wrapper">
                            <RadzenIcon Icon="school" Style="font-size: 2rem; color: white;" />
                        </div>
                        <div>
                            <h1 style="margin: 0; color: var(--primary-color); font-weight: 800; font-size: 2rem; line-height: 1.2;">@details.Title</h1>
                            <span style="color: var(--text-muted); font-size: 1rem; font-weight: 500;">@details.Section</span>
                        </div>
                    </RadzenStack>

                    <div style="margin-top: 15px; display: flex; align-items: center; gap: 15px;">
                        <div class="meta-pill">
                            <RadzenIcon Icon="person" Style="font-size: 1rem;" />
                            <span>@details.OwnerName</span>
                        </div>
                        <!-- Можна додати кількість учасників тут, якщо є в DTO -->
                    </div>

                    @if (!string.IsNullOrWhiteSpace(details.Description))
                    {
                        <p style="margin-top: 15px; color: var(--text-secondary); line-height: 1.6;">@details.Description</p>
                    }
                </div>

                <!-- Invite Code Box -->
                <div class="invite-card">
                    <span class="invite-label">Код приєднання</span>
                    <div class="code-display" @onclick="CopyInviteLink" title="Натисніть, щоб скопіювати посилання">
                        <span class="code-text">@details.JoinCode</span>
                        <RadzenIcon Icon="content_copy" Style="font-size: 1.2rem; color: var(--primary-color);" />
                    </div>
                </div>
            </RadzenStack>
        </div>

        <!-- TEACHER TOOLBAR (Видно тільки викладачам) -->
        @if (IsTeacher)
        {
            <div class="teacher-toolbar">
                <RadzenText Text="ПАНЕЛЬ ВИКЛАДАЧА" TextStyle="TextStyle.Caption" Style="color: var(--text-muted); font-weight: 700; margin-bottom: 10px; display: block;" />

                <RadzenStack Orientation="Orientation.Horizontal" Gap="10px" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="Нове завдання" Icon="add_task" Class="btn-primary-custom" Click="@(() => Nav.NavigateTo($"/classrooms/{ClassroomId}/assignments/create"))" />

                    <RadzenButton Text="Додати матеріал" Icon="library_add"
                                  ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                  Style="border-radius: 10px; color: var(--text-secondary); border-color: #cbd5e1; font-weight: 600;"
                                  Click="@(() => Nav.NavigateTo($"/classrooms/{ClassroomId}/materials/create"))" />

                    <div style="flex: 1;"></div> <!-- Spacer -->

                    <RadzenButton Text="Редагувати клас" Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Style="color: var(--text-secondary);" />
                    <RadzenButton Text="Налаштування" Icon="settings" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Style="color: var(--text-secondary);" />
                </RadzenStack>
            </div>
        }

        <!-- TABS CONTENT -->
        <RadzenTabs RenderMode="TabRenderMode.Client" Style="background: transparent; box-shadow: none; border: none; margin-top: 20px;">
            <Tabs>
                <RadzenTabsItem Text="Огляд" Icon="dashboard">
                    <div class="tab-content-wrapper">
                        <!-- Placeholder for dashboard widgets -->
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="8">
                                <div class="content-placeholder">
                                    <RadzenIcon Icon="campaign" Style="font-size: 3rem; color: var(--accent-color); opacity: 0.5; margin-bottom: 10px;" />
                                    <p>Стрічка новин та оголошень класу буде тут.</p>
                                </div>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <div class="content-placeholder">
                                    <RadzenIcon Icon="event" Style="font-size: 3rem; color: var(--primary-light); opacity: 0.5; margin-bottom: 10px;" />
                                    <p>Найближчі події та дедлайни.</p>
                                </div>
                            </RadzenColumn>
                        </RadzenRow>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Учасники" Icon="groups">
                    <div class="tab-content-wrapper">
                        <RadzenDataGrid Data="@details.Members" TItem="ClassroomMemberDto" Class="glass-grid" AllowSorting="true">
                            <Columns>
                                <RadzenDataGridColumn TItem="ClassroomMemberDto" Property="FullName" Title="Ім'я">
                                    <Template Context="row">
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <div style="width: 32px; height: 32px; background: rgba(0,33,113,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary-color); font-weight: 700; font-size: 0.8rem;">
                                                @row.FullName.Substring(0, 1)
                                            </div>
                                            <span style="font-weight: 600; color: var(--text-main);">@row.FullName</span>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ClassroomMemberDto" Property="Email" Title="Email" />
                                <RadzenDataGridColumn TItem="ClassroomMemberDto" Property="RoleInClass" Title="Роль">
                                    <Template Context="row">
                                        @if (row.RoleInClass == "Teacher")
                                        {
                                            <RadzenBadge Text="Викладач" BadgeStyle="BadgeStyle.Primary" IsPill="true" Style="background-color: var(--primary-light);" />
                                        }
                                        else
                                        {
                                            <RadzenBadge Text="Студент" BadgeStyle="BadgeStyle.Light" IsPill="true" Style="color: var(--text-secondary); border: 1px solid #cbd5e1;" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Матеріали" Icon="library_books">
                    <div class="tab-content-wrapper">
                        @if (IsTeacher)
                        {
                            <div style="margin-bottom: 20px;">
                                <RadzenButton Text="Додати матеріал" Icon="add" Class="btn-primary-custom" Click="@(() => Nav.NavigateTo($"/classrooms/{ClassroomId}/materials/create"))" />
                            </div>
                        }
                        <div class="content-placeholder">
                            <RadzenIcon Icon="folder_open" Style="font-size: 3rem; color: var(--text-muted); opacity: 0.5; margin-bottom: 10px;" />
                            <p>Список навчальних матеріалів.</p>
                        </div>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Завдання" Icon="assignment">
                    <div class="tab-content-wrapper">
                        @if (IsTeacher)
                        {
                            <div style="margin-bottom: 20px;">
                                <RadzenButton Text="Створити завдання" Icon="add_task" Class="btn-primary-custom" Click="@(() => Nav.NavigateTo($"/classrooms/{ClassroomId}/assignments/create"))" />
                            </div>
                        }
                        <div class="content-placeholder">
                            <RadzenIcon Icon="quiz" Style="font-size: 3rem; color: var(--text-muted); opacity: 0.5; margin-bottom: 10px;" />
                            <p>Список активних завдань.</p>
                        </div>
                    </div>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
</div>


@code {
    [Parameter] public Guid ClassroomId { get; set; }

    private ClassroomDetailsDto? details;
    private bool isLoading = true;
    private string? error;

    private bool IsAuthenticated => CurrentUser.User != null;
    private bool IsTeacher =>
        CurrentUser.User?.Roles?.Any(r =>
            string.Equals(r, "teacher", StringComparison.OrdinalIgnoreCase) ||
            r.Contains("викладач", StringComparison.OrdinalIgnoreCase)
        ) == true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            if (CurrentUser.User is null)
            {
                isLoading = false;
                return;
            }

            var userIdStr = CurrentUser.User.UserId;
            if (string.IsNullOrWhiteSpace(userIdStr) || !Guid.TryParse(userIdStr, out var userId))
            {
                error = "Invalid user id.";
                return;
            }

            details = await ClassroomService
                .GetClassroomDetailsAsync(ClassroomId, userId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string InviteUrl =>
        details == null
            ? string.Empty
            : $"{Nav.BaseUri.TrimEnd('/')}/join/{details.JoinCode}";

    private async Task CopyInviteLink()
    {
        if (string.IsNullOrEmpty(InviteUrl))
            return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", InviteUrl);

            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Посилання скопійовано",
                Detail = "Надішліть його студентам",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка копіювання",
                Detail = ex.Message,
                Duration = 4000
            });
        }
    }
}