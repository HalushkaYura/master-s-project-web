@page
@model SmartClass.Web.Components.Pages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Classroom</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Classroom.OwnerId" class="control-label"></label>
                <select asp-for="Classroom.OwnerId" class ="form-control" asp-items="ViewBag.OwnerId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Classroom.Title" class="control-label"></label>
                <input asp-for="Classroom.Title" class="form-control" />
                <span asp-validation-for="Classroom.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Classroom.Section" class="control-label"></label>
                <input asp-for="Classroom.Section" class="form-control" />
                <span asp-validation-for="Classroom.Section" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Classroom.JoinCode" class="control-label"></label>
                <input asp-for="Classroom.JoinCode" class="form-control" />
                <span asp-validation-for="Classroom.JoinCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Classroom.Description" class="control-label"></label>
                <input asp-for="Classroom.Description" class="form-control" />
                <span asp-validation-for="Classroom.Description" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Classroom.IsArchived" /> @Html.DisplayNameFor(model => model.Classroom.IsArchived)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Classroom.CreatedAt" class="control-label"></label>
                <input asp-for="Classroom.CreatedAt" class="form-control" />
                <span asp-validation-for="Classroom.CreatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
