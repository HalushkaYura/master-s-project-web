</style>

@code {
    [Parameter] public Guid ClassroomId { get; set; }

    private GradebookDto? gradebook;
    private bool isLoading = true;
    private string? error;

    private string searchStudent = string.Empty;
    private string assignmentFilter = "all";
    private bool pointsMode = true; // true = бали, false = %
    private bool showOnlyActiveStudents = true; // поки що всі активні
    private bool editMode = false;

    // Вибір клітинки для оцінювання
    private GradebookRowDto? selectedRow;
    private GradebookAssignmentDto? selectedAssignment;
    private GradebookCellDto? selectedCell;
    private decimal? editScore;
    private string? editComment;

    private bool IsAuthenticated => CurrentUser.User != null;

    private bool IsTeacher =>
        CurrentUser.User?.Roles?.Any(r =>
            string.Equals(r, "teacher", StringComparison.OrdinalIgnoreCase) ||
            r.Contains("викладач", StringComparison.OrdinalIgnoreCase)
        ) == true;

    // --- Ініціалізація ---

    protected override async Task OnInitializedAsync()
    {
        if (!IsAuthenticated || !IsTeacher)
        {
            isLoading = false;
            return;
        }

        await LoadGradebook();
    }

    private async Task LoadGradebook()
    {
        isLoading = true;
        error = null;

        try
        {
            gradebook = await GradebookService.GetForClassroomAsync(ClassroomId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // --- Метадані / статистика ---

    private int TotalStudents => gradebook?.Rows.Count ?? 0;
    private int TotalAssignments => gradebook?.Assignments.Count ?? 0;

    private decimal? AveragePercent
    {
        get
        {
            if (gradebook is null) return null;

            decimal totalScore = 0;
            decimal totalMax = 0;

            foreach (var row in gradebook.Rows)
            {
                foreach (var cell in row.Cells)
                {
                    if (cell.Score.HasValue && cell.MaxPoints > 0)
                    {
                        totalScore += cell.Score.Value;
                        totalMax += cell.MaxPoints;
                    }
                }
            }

            if (totalMax == 0) return null;
            return totalScore / totalMax * 100m;
        }
    }

    private int SubmittedCount
        => gradebook?.Rows.Sum(r => r.Cells.Count(c => c.Status == SubmissionStatus.Submitted || c.Status == SubmissionStatus.Graded || c.Status == SubmissionStatus.ReturnedForRevision)) ?? 0;

    private int PossibleSubmissionsCount
        => (gradebook?.Rows.Count ?? 0) * (gradebook?.Assignments.Count ?? 0);

    private int NotSubmittedCount
        => gradebook?.Rows.Sum(r => r.Cells.Count(c => c.Status == SubmissionStatus.NotSubmitted)) ?? 0;

    private int PublishedAssignmentsCount
        => gradebook?.Assignments.Count(a => string.Equals(a.Status, "Published", StringComparison.OrdinalIgnoreCase)) ?? 0;

    private int ClosedAssignmentsCount
        => gradebook?.Assignments.Count(a => string.Equals(a.Status, "Closed", StringComparison.OrdinalIgnoreCase)) ?? 0;

    // --- Фільтри ---

    private IEnumerable<GradebookAssignmentDto> VisibleAssignments
    {
        get
        {
            if (gradebook is null)
                return Enumerable.Empty<GradebookAssignmentDto>();

            var q = gradebook.Assignments.AsEnumerable();

            switch (assignmentFilter)
            {
                case "published":
                    q = q.Where(a => string.Equals(a.Status, "Published", StringComparison.OrdinalIgnoreCase));
                    break;
                case "with-deadline":
                    q = q.Where(a => a.DueAt != null);
                    break;
                case "with-grades":
                    q = q.Where(a =>
                        gradebook.Rows.Any(r =>
                            r.Cells.Any(c => c.AssignmentId == a.AssignmentId && c.Score.HasValue)));
                    break;
            }

            return q;
        }
    }

    private IEnumerable<GradebookRowDto> FilteredRows
    {
        get
        {
            if (gradebook is null)
                return Enumerable.Empty<GradebookRowDto>();

            var q = gradebook.Rows.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchStudent))
            {
                var s = searchStudent.Trim().ToLowerInvariant();
                q = q.Where(r => r.StudentName != null &&
                                 r.StudentName.ToLowerInvariant().Contains(s));
            }

            // showOnlyActiveStudents – на майбутнє, зараз всі активні
            return q;
        }
    }

    private readonly IEnumerable<object> assignmentFilterOptions = new[]
    {
        new { Text = "Усі завдання", Value = "all" },
        new { Text = "Тільки опубліковані", Value = "published" },
        new { Text = "Тільки з дедлайном", Value = "with-deadline" },
        new { Text = "Тільки з оцінками", Value = "with-grades" }
    };

    private readonly IEnumerable<object> pointsModeOptions = new[]
    {
        new { Text = "Бали", Value = true },
        new { Text = "% від макс.", Value = false }
    };

    // --- Обробка клітинок / вибір ---

    private void OnCellClick(GradebookRowDto row, GradebookAssignmentDto assignment, GradebookCellDto cell)
    {
        if (!editMode)
            return;

        selectedRow = row;
        selectedAssignment = assignment;
        selectedCell = cell;

        editScore = cell.Score;
        editComment = cell.Comment;
    }

    private void ClearSelection()
    {
        selectedRow = null;
        selectedAssignment = null;
        selectedCell = null;
        editScore = null;
        editComment = null;
    }

    // --- Збереження оцінки ---

    private async Task SaveGradeAsync()
    {
        if (!editMode ||
            selectedRow == null ||
            selectedAssignment == null ||
            editScore == null)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Немає вибраної комірки",
                Detail = "Оберіть студента та завдання в таблиці.",
                Duration = 3000
            });
            return;
        }

        try
        {
            if (CurrentUser.User is null || !Guid.TryParse(CurrentUser.User.UserId, out var teacherId))
            {
                Toast.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Помилка",
                    Detail = "Некоректний користувач.",
                    Duration = 4000
                });
                return;
            }

            // 1) Гарантуємо існування Submission для цього студент × завдання
            var submission = await SubmissionService.EnsureForStudentAsync(
                selectedAssignment.AssignmentId,
                selectedRow.StudentId,
                CancellationToken.None);

            // 2) Виставляємо оцінку
            var dto = new GradeSubmissionDto(
                submission.Id,
                editScore.Value,
                editComment);

            await SubmissionService.GradeAsync(dto, teacherId, CancellationToken.None);

            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Оцінку збережено",
                Detail = $"{selectedRow.StudentName}: {editScore} / {selectedAssignment.MaxPoints}",
                Duration = 3000
            });

            // 3) Перезавантажуємо журнал
            await LoadGradebook();

            // 4) Оновлюємо вибрану клітинку згідно з новими даними (опційно можна занулити)
            ClearSelection();
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка при збереженні оцінки",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    // --- Допоміжні методи для відображення ---

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(1, parts[0].Length)).ToUpperInvariant();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    private string ShortenTitle(string title, int maxLen = 18)
    {
        if (string.IsNullOrEmpty(title)) return "";
        return title.Length <= maxLen ? title : title.Substring(0, maxLen - 1) + "…";
    }

    private string GetAssignmentTooltip(GradebookAssignmentDto a)
    {
        var due = a.DueAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Без дедлайну";
        return $"{a.Title}\nМакс. бал: {a.MaxPoints}\nДедлайн: {due}\nСтатус: {a.Status}";
    }

    private string GetCellTooltip(GradebookRowDto row, GradebookAssignmentDto a, GradebookCellDto cell)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(row.StudentName);
        sb.AppendLine(a.Title);
        sb.AppendLine($"Статус: {cell.Status}");

        if (cell.Score.HasValue)
            sb.AppendLine($"Оцінка: {cell.Score}/{a.MaxPoints}");

        if (cell.SubmittedAt != null)
            sb.AppendLine($"Надіслано: {cell.SubmittedAt.Value.ToLocalTime():dd.MM.yyyy HH:mm}");

        if (!string.IsNullOrWhiteSpace(cell.Comment))
            sb.AppendLine($"Коментар: {cell.Comment}");

        return sb.ToString();
    }

    private MarkupString RenderCellContent(GradebookCellDto cell, GradebookAssignmentDto a)
    {
        if (cell.Status == SubmissionStatus.NotSubmitted && cell.SubmittedAt == null)
            return (MarkupString)"—";

        string text;

        if (pointsMode)
        {
            // Режим "бали"
            if (cell.Score.HasValue)
                text = $"{cell.Score}/{a.MaxPoints}";
            else if (cell.Status == SubmissionStatus.Submitted)
                text = "Очікує";
            else
                text = "—";
        }
        else
        {
            // Режим "% від макс."
            if (cell.Score.HasValue && a.MaxPoints > 0)
            {
                var percent = (decimal)cell.Score.Value / a.MaxPoints * 100m;
                text = $"{percent:F0}%";
            }
            else if (cell.Status == SubmissionStatus.Submitted)
                text = "Очікує";
            else
                text = "—";
        }

        return (MarkupString)text;
    }

    private string GetCellCssClass(GradebookCellDto cell)
    {
        return cell.Status switch
        {
            SubmissionStatus.NotSubmitted => "grade-cell grade-not-submitted",
            SubmissionStatus.Submitted => "grade-cell grade-submitted",
            SubmissionStatus.Graded => GetGradedCss(cell),
            SubmissionStatus.ReturnedForRevision => "grade-cell grade-returned",
            _ => "grade-cell grade-empty"
        };
    }

    private string GetGradedCss(GradebookCellDto cell)
    {
        if (!cell.Score.HasValue || cell.MaxPoints <= 0)
            return "grade-cell grade-graded-bad";

        var p = cell.Score.Value / cell.MaxPoints * 100m;
        return p >= 60m ? "grade-cell grade-graded-good" : "grade-cell grade-graded-bad";
    }

    private decimal? CalculateRowTotal(GradebookRowDto row)
    {
        if (row.Cells is null) return null;

        var scores = row.Cells.Where(c => c.Score.HasValue).Select(c => c.Score!.Value).ToList();
        if (!scores.Any()) return null;

        return scores.Sum();
    }

    private decimal? CalculateRowAveragePercent(GradebookRowDto row)
    {
        if (row.Cells is null) return null;

        decimal totalScore = 0;
        decimal totalMax = 0;

        foreach (var c in row.Cells)
        {
            if (c.Score.HasValue && c.MaxPoints > 0)
            {
                totalScore += c.Score.Value;
                totalMax += c.MaxPoints;
            }
        }

        if (totalMax == 0) return null;

        return totalScore / totalMax * 100m;
    }

