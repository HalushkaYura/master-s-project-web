@page "/classrooms/{ClassroomId:guid}/gradebook"
@layout MainLayout

@using SmartClass.Application.Abstractions
@using SmartClass.Application.Contracts.Gradebook
@using SmartClass.Application.Contracts.Submissions
@using SmartClass.Application.Contracts
@using SmartClass.Web.Services
@using SmartClass.Domain.Enums
@using Radzen

@inject IGradebookService GradebookService
@inject ISubmissionService SubmissionService
@inject CurrentUserState CurrentUser
@inject NavigationManager Nav
@inject Radzen.NotificationService Toast

<PageTitle>@(gradebook is null ? "Журнал оцінок" : $"Журнал: {gradebook.ClassroomTitle}")</PageTitle>

<div class="animate-fade-in">

    @if (isLoading)
    {
        <div style="display:flex;justify-content:center;align-items:center;height:300px;">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Medium"
                                       Style="color: var(--primary-color);" />
        </div>
    }
    else if (!IsAuthenticated)
    {
        <RadzenAlert Severity="AlertSeverity.Warning" Variant="Variant.Flat">
            Для перегляду журналу оцінок потрібно увійти в систему.
        </RadzenAlert>
    }
    else if (!IsTeacher)
    {
        <RadzenAlert Severity="AlertSeverity.Info" Variant="Variant.Flat">
            Журнал оцінок у повному вигляді доступний тільки викладачам.
            <br />
            Ви можете переглянути свої власні оцінки на сторінці
            <RadzenLink Text="&quot;Мої оцінки&quot;"
                        Click="@GoToMyGrades" Style="font-weight:600;" />.
        </RadzenAlert>
    }
    else if (error != null)
    {
        <RadzenAlert Severity="AlertSeverity.Error" Variant="Variant.Flat">
            @error
        </RadzenAlert>
    }
    else if (gradebook != null)
    {
        <!-- HEADER -->
        <div class="gradebook-header">
            <div class="gradebook-header-left">
                <div class="gradebook-icon">
                    <RadzenIcon Icon="table_chart" />
                </div>
                <div>
                    <h1 class="gradebook-title">
                        @gradebook.ClassroomTitle
                    </h1>
                    <p class="gradebook-subtitle">
                        Журнал оцінок
                    </p>
                    <div class="gradebook-meta">
                        <span>
                            <RadzenIcon Icon="groups" Style="font-size:1rem;margin-right:4px;" />
                            Студентів: <b>@TotalStudents</b>
                        </span>
                        <span>
                            <RadzenIcon Icon="assignment" Style="font-size:1rem;margin-right:4px;" />
                            Завдань: <b>@TotalAssignments</b>
                        </span>
                        <span>
                            <RadzenIcon Icon="analytics" Style="font-size:1rem;margin-right:4px;" />
                            Середній %: <b>@(AveragePercent.HasValue ? $"{AveragePercent:F1}%" : "—")</b>
                        </span>
                    </div>
                </div>
            </div>

            <div class="gradebook-header-right">
                <RadzenButton Icon="arrow_back"
                              Text="До класу"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Outlined"
                              Click="@GoBackToClassroom"
                              Style="margin-right:8px;" />

                <RadzenButton Icon="file_download"
                              Text="Експорт"
                              ButtonStyle="ButtonStyle.Secondary"
                              Variant="Variant.Outlined"
                              Click="@ExportGradebook"
                              Style="margin-right:8px;" />

                <RadzenButton Icon="print"
                              Text="Друк"
                              ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Outlined"
                              Click="@PrintGradebook" />
            </div>
        </div>

        <!-- FILTER BAR -->
        <div class="gradebook-filter-bar">
            <RadzenTextBox @bind-Value="searchStudent"
                           Placeholder="Пошук студента..."
                           Style="width:250px;">
                <Prefix>
                    <RadzenIcon Icon="search" Style="margin-right:4px;" />
                </Prefix>
            </RadzenTextBox>

            <RadzenDropDown @bind-Value="assignmentFilter"
                            Data="@assignmentFilterOptions"
                            TextProperty="Text"
                            ValueProperty="Value"
                            Style="width:220px;margin-left:12px;"
                            Placeholder="Фільтр завдань" />

            <RadzenDropDown @bind-Value="pointsMode"
                            Data="@pointsModeOptions"
                            TextProperty="Text"
                            ValueProperty="Value"
                            Style="width:180px;margin-left:12px;"
                            Placeholder="Вид балів" />

            <RadzenCheckBox @bind-Value="showOnlyActiveStudents"
                            Style="margin-left:18px;" />
            <span style="margin-left:4px;font-size:0.9rem;color:var(--text-secondary);">
                Показувати тільки активних студентів
            </span>

            <RadzenCheckBox @bind-Value="editMode"
                            Style="margin-left:auto;" />
            <span style="margin-left:4px;font-size:0.9rem;font-weight:600;color:var(--primary-color);">
                Режим редагування оцінок
            </span>
        </div>

        <!-- MAIN CONTENT -->
        <RadzenRow Gap="1.5rem">

            <!-- TABLE -->
            <RadzenColumn Size="12" SizeLG="9">
                <div class="gradebook-table-wrapper">
                    <RadzenDataGrid Data="@FilteredRows"
                                    TItem="GradebookRowDto"
                                    Class="gradebook-grid"
                                    AllowPaging="false"
                                    AllowSorting="false"
                                    AllowFiltering="false">
                        <Columns>
                            <!-- STUDENT COLUMN -->
                            <RadzenDataGridColumn TItem="GradebookRowDto" Title="Студент" Frozen="true" Width="220px">
                                <Template Context="row">
                                    <div class="student-cell">
                                        <div class="student-avatar">
                                            @GetInitials(row.StudentName)
                                        </div>
                                        <div class="student-info">
                                            <div class="student-name">@row.StudentName</div>
                                        </div>
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>

                            <!-- DYNAMIC ASSIGNMENT COLUMNS -->
                            @foreach (var a in VisibleAssignments)
                            {
                                <RadzenDataGridColumn TItem="GradebookRowDto"
                                                      Title="@ShortenTitle(a.Title)"
                                                      Width="130px">
                                    <HeaderTemplate>
                                        <div class="assignment-header"
                                             title="@GetAssignmentTooltip(a)">
                                            <div class="assignment-title-short">
                                                @ShortenTitle(a.Title)
                                            </div>
                                            <div class="assignment-meta">
                                                @if (a.DueAt != null)
                                                {
                                                    <span>@a.DueAt.Value.ToLocalTime().ToString("dd.MM")</span>
                                                }
                                                <span>@a.MaxPoints б.</span>
                                            </div>
                                        </div>
                                    </HeaderTemplate>
                                    <Template Context="row">
                                        @{
                                            var cell = row.Cells.FirstOrDefault(c => c.AssignmentId == a.AssignmentId);
                                        }

                                        @if (cell is null)
                                        {
                                            <div class="grade-cell grade-empty">
                                                —
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="@GetCellCssClass(cell)"
                                                 title="@GetCellTooltip(row, a, cell)"
                                                 @onclick="@(() => OnCellClick(row, a, cell))"
                                                 style="cursor:@(editMode ? "pointer" : "default");">
                                                @RenderCellContent(cell, a)
                                                @if (!string.IsNullOrWhiteSpace(cell.Comment))
                                                {
                                                    <RadzenIcon Icon="chat_bubble_outline"
                                                                Style="font-size:0.9rem;margin-left:4px;opacity:0.7;" />
                                                }
                                            </div>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            }

                            <!-- TOTAL / AVERAGE -->
                            <RadzenDataGridColumn TItem="GradebookRowDto" Title="Сума" Width="90px">
                                <Template Context="row">
                                    @{
                                        var sum = CalculateRowTotal(row);
                                    }
                                    <span class="row-total">
                                        @(sum.HasValue ? $"{sum:F1}" : "—")
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="GradebookRowDto" Title="Середній %" Width="110px">
                                <Template Context="row">
                                    @{
                                        var avg = CalculateRowAveragePercent(row);
                                    }
                                    <span class="row-average">
                                        @(avg.HasValue ? $"{avg:F1}%" : "—")
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>

                <!-- STATS -->
                <div class="gradebook-stats">
                    <RadzenCard Style="flex:1; margin-right:12px;">
                        <div class="stats-title">Загальна статистика</div>
                        <div class="stats-row">
                            <span>Середній бал (відносно макс.):</span>
                            <b>@(AveragePercent.HasValue ? $"{AveragePercent:F1}%" : "—")</b>
                        </div>
                        <div class="stats-row">
                            <span>Подано робіт:</span>
                            <b>@SubmittedCount / @PossibleSubmissionsCount</b>
                        </div>
                        <div class="stats-row">
                            <span>Несдані роботи:</span>
                            <b>@NotSubmittedCount</b>
                        </div>
                    </RadzenCard>

                    <RadzenCard Style="flex:1;">
                        <div class="stats-title">Інфо по завданнях</div>
                        <div class="stats-row">
                            <span>Опубліковані завдання:</span>
                            <b>@PublishedAssignmentsCount</b>
                        </div>
                        <div class="stats-row">
                            <span>Закриті завдання:</span>
                            <b>@ClosedAssignmentsCount</b>
                        </div>
                    </RadzenCard>
                </div>
            </RadzenColumn>

            <!-- RIGHT PANEL: GRADE EDIT PANEL -->
            <RadzenColumn Size="12" SizeLG="3">
                <div class="grade-panel">
                    <RadzenText Text="Панель оцінювання"
                                TextStyle="TextStyle.H6"
                                Style="font-weight:700;margin-bottom:8px;" />

                    @if (!editMode)
                    {
                        <p class="text-muted" style="font-size:0.9rem;">
                            Увімкніть <b>“Режим редагування оцінок”</b>, щоб вибрати клітинку й виставити/змінити оцінку.
                        </p>
                    }
                    else if (selectedCell == null || selectedAssignment == null || selectedRow == null)
                    {
                        <p class="text-muted" style="font-size:0.9rem;">
                            Натисніть на клітинку в таблиці, щоб оцінити роботу студента.
                        </p>
                    }
                    else
                    {
                        <div class="grade-panel-body">
                            <p style="margin-bottom:4px;">
                                <span style="font-size:0.85rem;color:var(--text-muted);">Студент:</span><br />
                                <b>@selectedRow.StudentName</b>
                            </p>

                            <p style="margin-bottom:4px;">
                                <span style="font-size:0.85rem;color:var(--text-muted);">Завдання:</span><br />
                                <b>@selectedAssignment.Title</b>
                            </p>

                            <p style="margin-bottom:8px;font-size:0.85rem;color:var(--text-muted);">
                                Макс. бал: <b>@selectedAssignment.MaxPoints</b><br />
                                Статус відповіді: <b>@selectedCell.Status.ToString()</b><br />
                                @if (selectedCell.SubmittedAt != null)
                                {
                                    <span>Надіслано: @selectedCell.SubmittedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                }
                            </p>

                            <RadzenNumeric @bind-Value="editScore"
                                           Placeholder="Оцінка"
                                           Style="width:100%;margin-bottom:8px;"
                                           Max="@selectedAssignment.MaxPoints"
                                           Min="0" />

                            <RadzenTextArea @bind-Value="editComment"
                                            Rows="3"
                                            Placeholder="Коментар викладача"
                                            Style="width:100%;margin-bottom:8px;" />

                            <RadzenButton Text="Зберегти оцінку"
                                          Icon="save"
                                          Class="btn-primary-custom"
                                          Style="width:100%;margin-bottom:6px;"
                                          Click="@SaveGradeAsync" />

                            <RadzenButton Text="Скинути вибір"
                                          Icon="close"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Outlined"
                                          Style="width:100%;"
                                          Click="@ClearSelection" />
                        </div>
                    }
                </div>
            </RadzenColumn>
        </RadzenRow>
    }
</div>

<style>
