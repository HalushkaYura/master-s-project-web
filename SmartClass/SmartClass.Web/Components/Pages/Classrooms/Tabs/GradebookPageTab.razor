        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        margin-bottom:20px;
        padding:16px 20px;
        background:linear-gradient(135deg,#e3f2fd,#f5f7ff);
        border-radius:16px;
        border:1px solid rgba(148,163,184,0.3);
    }

    .gradebook-header-left {
        display:flex;
        align-items:flex-start;
        gap:16px;
    }

    .gradebook-icon {
        width:48px;
        height:48px;
        border-radius:14px;
        background:rgba(0,33,113,0.1);
        display:flex;
        align-items:center;
        justify-content:center;
        color:var(--primary-color);
        font-size:1.8rem;
    }

    .gradebook-title {
        margin:0;
        font-size:1.6rem;
        font-weight:800;
        color:var(--primary-color);
    }

    .gradebook-subtitle {
        margin:2px 0 6px 0;
        color:var(--text-secondary);
    }

    .gradebook-meta {
        display:flex;
        gap:16px;
        font-size:0.9rem;
        color:var(--text-secondary);
    }

    .gradebook-header-right {
        display:flex;
        align-items:center;
    }

    .gradebook-filter-bar {
        display:flex;
        align-items:center;
        gap:8px;
        padding:10px 4px 16px 4px;
    }

    .gradebook-table-wrapper {
        overflow-x:auto;
        border-radius:12px;
        border:1px solid rgba(148,163,184,0.4);
        background:rgba(255,255,255,0.8);
    }

    .gradebook-grid .rz-data-grid-table {
        font-size:0.85rem;
    }

    .student-cell {
        display:flex;
        align-items:center;
        gap:8px;
    }

    .student-avatar {
        width:28px;
        height:28px;
        border-radius:50%;
        background:rgba(0,33,113,0.1);
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:0.8rem;
        font-weight:700;
        color:var(--primary-color);
    }

    .student-name {
        font-weight:600;
        color:var(--text-main);
    }

    .assignment-header {
        font-size:0.8rem;
        text-align:center;
    }

    .assignment-title-short {
        font-weight:600;
        color:var(--text-main);
    }

    .assignment-meta {
        font-size:0.75rem;
        color:var(--text-muted);
        display:flex;
        justify-content:center;
