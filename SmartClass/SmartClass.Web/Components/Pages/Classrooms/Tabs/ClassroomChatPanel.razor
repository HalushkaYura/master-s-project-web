@page "/1"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using SmartClass.Application.Abstractions.Auth
@using Radzen
@using SmartClass.Web.Services
@using System.Net.Http
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using System.Net

@inject NavigationManager Nav
@inject HttpClient Http
@inject ITokenProvider TokenProvider
@inject CurrentUserState CurrentUser
@inject NotificationService Toast
@inject IJSRuntime JS

@implements IAsyncDisposable
<style>
    /* --- ОСНОВНА ОБГОРТКА --- */
    .chat-wrapper {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 10px;
        background: transparent;
    }

    /* Контейнер історії */
    .chat-messages-container {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
        background: #f8fafc; /* дуже світлий сірий */
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        box-shadow: inset 0 0 6px rgba(0,0,0,0.03);
        display: flex;
        flex-direction: column;
    }

    .empty-chat-text {
        text-align: center;
        margin-top: 20px;
        color: #94a3b8;
    }

    /* --- БУЛЬБАШКИ --- */
    .chat-message-row {
        display: flex;
        margin-bottom: 12px;
    }

    .align-right {
        justify-content: flex-end;
    }

    .align-left {
        justify-content: flex-start;
    }

    .chat-message {
        padding: 10px 14px;
        border-radius: 14px;
        max-width: 80%;
        font-size: 0.9rem;
        transition: all .2s;
    }

    /* === ВЛАСНІ ПОВІДОМЛЕННЯ (PRIMARY BLUE) === */
    .own-bubble {
        background: #2563eb; /* primary */
        color: #ffffff;
        border-bottom-right-radius: 6px;
        box-shadow: 0 3px 8px rgba(37,99,235,0.3);
    }

        .own-bubble .chat-author {
            color: #bfdbfe; /* світлий блакитний */
        }

    /* === ІНШІ ПОВІДОМЛЕННЯ (WHITE) === */
    .other-bubble {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #1e293b;
        border-bottom-left-radius: 6px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

        .other-bubble .chat-author {
            color: #3b82f6; /* мʼякий синій акцент */
        }

    /* Автор і час */
    .chat-message-header {
        font-size: 0.75rem;
        margin-bottom: 4px;
    }

    .chat-time {
        display: block;
        text-align: right;
        font-size: 0.65rem;
        opacity: 0.6;
        margin-top: 4px;
    }

    /* --- INPUT AREA --- */
    .chat-input-area {
        display: flex;
        align-items: flex-end;
        padding-top: 12px;
    }

        .chat-input-area textarea {
            background: #ffffff !important;
            color: #1e293b !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 10px;
        }

            .chat-input-area textarea::placeholder {
                color: #94a3b8;
            }

    /* --- КНОПКА ВІДПРАВКИ (ОНОВЛЕНО) --- */
    /* --- КНОПКА ВІДПРАВКИ (ФІНАЛЬНЕ ВИПРАВЛЕННЯ) --- */
    .send-button-native {
        /* Використовуємо фіксовані HEX-значення з вашої палітри:
           --primary-color: #002171; --primary-light: #3e50b4; */
        background: linear-gradient(135deg, #002171, #3e50b4); /* Синій градієнт */
        color: white;
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 33, 113, 0.3);
        /* ... інші стилі ... */
    }

        .send-button-native:hover:not(:disabled) {
            background: linear-gradient(135deg, #0033a0, #4a68c0);
            /* ... інші стилі ... */
        }

        .send-button-native:disabled {
            background: #d1d5db; /* Світло-сірий */
            color: #9ca3af;
            /* ... інші стилі ... */
        }

</style>
<div class="chat-wrapper">

    <!-- HEADER -->
    <div>
        <h4 style="color: var(--primary-color); font-weight: 700; margin: 0;"> @channelTitle</h4>
        <span class="chat-channel-title" style="color: var(--text-muted); font-size: 0.8rem;">@messages.Count повідомлень</span>
    </div>

    <!-- 1. ІСТОРІЯ ПОВІДОМЛЕНЬ (Контейнер скролу) -->
    @if (isLoading)
    {
        <div class="chat-messages-container text-center loading">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"  Style="color: var(--primary-color);" />
        </div>
    }
    else if (error != null)
    {
        <div class="chat-messages-container text-center error-state">
            <RadzenIcon Icon="error" style="color: #ef4444;" /><p class="text-muted">@error</p>
        </div>
    }
    else
    {
        <div class="chat-messages-container" @ref="messagesContainer">
            @if (!messages.Any())
            {
                <p class="text-center text-muted empty-chat-text">Повідомлень поки немає. Напишіть першим!</p>
            }
            else
            {
                @foreach (var m in messages)
                {
                    <!-- ВИПРАВЛЕНО: Бульбашка тепер має чіткий білий фон для контрасту -->
                    <div class="chat-message-row @(m.AuthorId.ToString() == CurrentUser.User?.UserId ? "align-right" : "align-left")">
                        <div class="chat-message @(m.AuthorId.ToString() == CurrentUser.User?.UserId ? "own-bubble" : "other-bubble")">
                            <div class="chat-message-header">
                                <span class="chat-author">@m.AuthorName</span>
                            </div>
                            <div class="chat-text">@m.Text</div>
                            <div class="chat-time">@m.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                        </div>
                    </div>
                }
            }
        </div>
    }

    <!-- 2. ПОЛЕ ВВОДУ -->
    <div class="chat-input-area">
        <RadzenTextArea @bind-Value="newMessage"
                        Placeholder="Напишіть повідомлення..."
                        Rows="2"
                        @onkeypress="HandleKeyPress"
                        Style="width:100%; border-radius: 10px; max-height: 100px; resize: none; margin-right: 8px; border-color: var(--text-muted) !important;" />

        <RadzenButton Icon="send"
                      Class="send-button-custom"
                      Variant="Variant.Flat"
                      Click="@Send"
                      Disabled="@string.IsNullOrWhiteSpace(newMessage)"
                      Style="padding: 0; width: 45px; height: 45px; flex-shrink: 0;" />
    </div>
</div>



@code {
    [Parameter] public Guid ClassroomId { get; set; }

    private Guid channelId;
    private string channelTitle = "Класу";

    private HubConnection? hubConnection;
    private List<ChatMessageDto> messages = new();
    private string? newMessage;

    private bool isLoading = true;
    private string? error;

    private ElementReference messagesContainer;
    private string? accessToken;

    private record ChannelDto(Guid Id, Guid ClassroomId, string Title);
    private record ChatMessageDto(Guid Id, Guid AuthorId, string AuthorName, string Text, DateTime CreatedAt);


    protected override async Task OnInitializedAsync()
    {
        await LoadChat();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isLoading && string.IsNullOrWhiteSpace(error))
        {
            await ScrollToBottom();
        }
    }

    private async Task LoadChat()
    {
        isLoading = true;
        try
        {
            // ... (Ваша логіка завантаження, яку ви надали)
            accessToken = await TokenProvider.GetAccessTokenAsync();
            if (string.IsNullOrWhiteSpace(accessToken)) { error = "Сесія завершена."; return; }

            var channel = await GetWithAuthAsync<ChannelDto>($"api/channels/by-classroom/{ClassroomId}", accessToken);
            if (channel == null) { error = "Канал не знайдено."; return; }
            channelId = channel.Id;
            channelTitle = channel.Title;

            messages = await GetWithAuthAsync<List<ChatMessageDto>>($"api/channels/{channelId}/messages?skip=0&take=50", accessToken) ?? new();

            // SignalR hub
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/chat"), options => { options.AccessTokenProvider = () => Task.FromResult(accessToken); })
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<ChatMessageDto>("MessageReceived", async message =>
            {
                messages.Add(message);
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            });

            await hubConnection.StartAsync();
            await hubConnection.InvokeAsync("JoinChannel", channelId.ToString());
        }
        catch (UnauthorizedAccessException) { error = "Доступ заборонено (401)."; }
        catch (Exception ex) { error = $"Помилка: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private async Task Send()
    {
        if (hubConnection == null || string.IsNullOrWhiteSpace(newMessage)) return;

        try
        {
            var text = newMessage.Trim();
            // ВАЖЛИВО: Очищаємо поле ДО відправки, щоб користувач міг швидко писати далі
            newMessage = string.Empty;
            await InvokeAsync(StateHasChanged);

            // Виклик методу на серверному хабі
            await hubConnection.InvokeAsync("SendMessage", channelId.ToString(), text);
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Помилка відправки", Detail = ex.Message });
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Send();
        }
    }

    private async Task ScrollToBottom()
    {
        // JS для прокрутки вниз
        await JS.InvokeVoidAsync("eval", $@"
            var container = document.querySelector('.chat-messages-container');
            if (container) {{
                container.scrollTop = container.scrollHeight;
            }}
        ");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private async Task<T?> GetWithAuthAsync<T>(string url, string token, CancellationToken ct = default)
    {
        using var req = new HttpRequestMessage(HttpMethod.Get, url);
        req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        var resp = await Http.SendAsync(req, ct);
        if (resp.StatusCode == HttpStatusCode.Unauthorized) throw new UnauthorizedAccessException();
        resp.EnsureSuccessStatusCode();
        return await resp.Content.ReadFromJsonAsync<T>(cancellationToken: ct);
    }
}