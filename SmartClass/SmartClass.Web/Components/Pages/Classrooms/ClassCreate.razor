@page "/classrooms/create"
@using Radzen
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Radzen.NotificationService NotificationService

<PageTitle>Create Classroom</PageTitle>

<EditForm Model="@model" OnValidSubmit="@HandleCreate" FormName="createClassForm">
    <RadzenCard Class="shadow-lg p-4 create-card">
        <h2 class="mb-4">Створити новий клас</h2>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label>Назва класу</label>
                <RadzenTextBox @bind-Value="model.Title"
                               Name="Title"
                               Style="width:100%" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Секція / група (необов’язково)</label>
                <RadzenTextBox @bind-Value="model.Section"
                               Name="Section"
                               Style="width:100%" />
            </div>

            <div class="col-12 mb-3">
                <label>Опис</label>
                <RadzenTextArea @bind-Value="model.Description"
                                Name="Description"
                                Style="width:100%;height:120px" />
            </div>
        </div>

        <div class="text-end mt-2">
            <RadzenButton Text="Створити"
                          Icon="add"
                          ButtonType="ButtonType.Submit"
                          Style="background:#4e73df;color:white" />
        </div>
    </RadzenCard>
</EditForm>

@code {
    // Локальна модель тільки з потрібними полями (OwnerId не передаємо)
    private CreateClassroomVm model = new();

    private class CreateClassroomVm
    {
        public string Title { get; set; } = string.Empty;
        public string? Section { get; set; }
        public string? Description { get; set; }
    }

    private async Task HandleCreate()
    {
        // додаємо Bearer, якщо ще не доданий
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "accessToken");
        if (string.IsNullOrWhiteSpace(token))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Не авторизовано",
                Detail = "Увійдіть у систему, щоб створювати класи."
            });
            Nav.NavigateTo("/login");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        // Відправляємо JSON, який за іменами полів мапиться на CreateClassroomCommand
        var response = await Http.PostAsJsonAsync("api/Classrooms", model);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            Console.WriteLine(error);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка",
                Detail = "Не вдалося створити клас."
            });
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<CreateClassroomResponse>();
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Клас створено",
            Detail = "Новий клас успішно створено."
        });

        await Task.Delay(800);
        if (body is not null)
        {
            Nav.NavigateTo($"/classrooms/{body.classroomId}");
        }
        else
        {
            Nav.NavigateTo("/"); // запасний варіант
        }
    }

    private sealed class CreateClassroomResponse
    {
        public Guid classroomId { get; set; }
    }
}
