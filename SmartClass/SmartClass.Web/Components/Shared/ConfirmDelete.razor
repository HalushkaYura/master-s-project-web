@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components

<!-- Забезпечуємо відображення вікна поверх іншого контенту -->
<div class="custom-modal-backdrop" style="display: @(IsOpenDelete ? "block" : "none")">
    
    <div class="custom-modal-dialog animate-fade-in">
        <div class="modal-content">
            
            <!-- Заголовок -->
            <div class="modal-header">
                <h5 class="modal-title">
                    <RadzenIcon Icon="warning" Style="color: #f59e0b; font-size: 1.2rem; vertical-align: middle; margin-right: 8px;" />
                    Підтвердження видалення
                </h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>
            
            <!-- Тіло -->
            <div class="modal-body">
                <!-- Параметр Message має бути тут, але ми використовуємо заглушку, бо його немає у вашому code-->
                <p style="color: var(--text-secondary);">Ви впевнені, що хочете видалити цей об'єкт?</p>
                <p style="color: var(--text-muted); font-size: 0.85rem;">Цю дію неможливо скасувати.</p>
            </div>
            
            <!-- Футер -->
            <div class="modal-footer d-flex justify-content-center">
                <RadzenButton Text="Скасувати" 
                              ButtonStyle="ButtonStyle.Secondary" 
                              Variant="Variant.Outlined" 
                              Click="CloseModal" 
                              Style="border-radius: 8px; font-weight: 600; margin-right: 12px;" />
                
                <RadzenButton Text="Видалити" 
                              Icon="delete" 
                              ButtonStyle="ButtonStyle.Danger" 
                              Click="DeleteConfirmed" 
                              Style="border-radius: 8px; font-weight: 600;" />
            </div>
        </div>
    </div>
</div>

<style>
    /* Затемнення фону */
    .custom-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(15, 23, 42, 0.5); /* Темний, прозорий фон */
        z-index: 1050; /* Поверх усіх Radzen елементів */
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .custom-modal-dialog {
        width: 100%;
        max-width: 400px;
        margin: 1.75rem auto;
    }

    .modal-content {
        background-color: var(--glass-bg); /* Світлий фон картки */
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        border: none;
    }

    .modal-header {
        background-color: #fef2f2; /* Дуже світлий червоний фон */
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        padding: 12px 20px;
        border-bottom: 1px solid #fecaca;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .modal-title {
        color: var(--text-main);
        font-weight: 600;
        font-size: 1rem;
        margin: 0;
    }

    .modal-body {
        padding: 20px;
        text-align: center;
    }

    .modal-footer {
        padding: 12px 20px;
        border-top: 1px solid #eee;
    }
</style>

@code {
    [Parameter] public bool IsOpenDelete { get; set; }
    [Parameter] public EventCallback<bool> OnDeleteConfirmed { get; set; }
    
    // Приймаємо повідомлення, якщо потрібно
    [Parameter] public string Message { get; set; } = "Ви впевнені, що хочете видалити цей об'єкт?";

    private void CloseModal()
    {
        IsOpenDelete = false;
        // Обов'язково викликаємо StateHasChanged, бо це компонент
        StateHasChanged();
        OnDeleteConfirmed.InvokeAsync(false);
    }

    private void DeleteConfirmed()
    {
        OnDeleteConfirmed.InvokeAsync(true);
        // Закриваємо вікно після підтвердження
        IsOpenDelete = false; 
        StateHasChanged();
    }
}