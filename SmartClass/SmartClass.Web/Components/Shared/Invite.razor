@page "/join/{JoinCode}"
@layout MainLayout

@using SmartClass.Application.Abstractions
@using SmartClass.Application.Contracts.Classrooms
@using SmartClass.Web.Services
@using Radzen

@inject IClassroomService ClassroomService
@inject CurrentUserState CurrentUser
@inject NavigationManager Nav
@inject NotificationService Toast

<PageTitle>Join Classroom</PageTitle>

@if (isLoading)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
}
else if (error != null)
{
    <RadzenAlert Severity="AlertSeverity.Error" Style="margin-top:12px;">
        @error
    </RadzenAlert>
}
else if (classroom != null)
{
    <RadzenContent Style="max-width:600px; margin:auto;">
        <RadzenPanel Style="padding:24px;">

            <RadzenHeading Size="H3" Text="Запрошення до класу" />

            <h4 class="mt-3">@classroom.Title</h4>

            @if (!string.IsNullOrWhiteSpace(classroom.Section))
            {
                <p style="color:#607D8B;">
                    Секція: @classroom.Section
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(classroom.Description))
            {
                <p style="margin-top:10px;">
                    @classroom.Description
                </p>
            }

            <RadzenAlert Severity="AlertSeverity.Info" Style="margin-top:12px;">
                Викладач: <b>@classroom.OwnerName</b>
            </RadzenAlert>

            <div class="mt-4 d-flex gap-2">
                @if (CurrentUser.User is null)
                {
                    <RadzenButton Text="Увійти для приєднання"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Nav.NavigateTo("/login"))" />
                }
                else
                {
                    <RadzenButton Text="✅ Приєднатися"
                                  ButtonStyle="ButtonStyle.Success"
                                  Click="@Join" />

                    <RadzenButton Text="❌ Скасувати"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Variant="Variant.Outlined"
                                  Click="@(() => Nav.NavigateTo("/"))" />
                }
            </div>

        </RadzenPanel>
    </RadzenContent>
}
@code {
    [Parameter] public string JoinCode { get; set; } = string.Empty;

    private ClassroomDetailsDto? classroom;
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            classroom = await ClassroomService
                .GetClassroomByJoinCodeAsync(JoinCode);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Join()
    {
        try
        {
            if (CurrentUser.User is null)
                return;

            if (!Guid.TryParse(CurrentUser.User.UserId, out var userId))
                return;

            await ClassroomService.JoinClassroomAsync(JoinCode, userId);

            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Успіх",
                Detail = "Ви приєдналися до класу!",
                Duration = 3000
            });

            Nav.NavigateTo($"/classrooms/{classroom!.Id}");
        }
        catch (Exception ex)
        {
            Toast.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Помилка",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }
}
